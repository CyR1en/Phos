pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  client_body_temp_path /tmp/nginx_body;
  proxy_temp_path /tmp/nginx_proxy;
  fastcgi_temp_path /tmp/nginx_fastcgi;
  uwsgi_temp_path /tmp/nginx_uwsgi;
  scgi_temp_path /tmp/nginx_scgi;
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log warn;

  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  server_tokens off;

  gzip on;
  gzip_comp_level 6;
  gzip_static on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

  server {
    listen ${LISTEN_PORT};
    server_name _;

    root /app/dist;
    index index.html;

    include /app/docker/nginx-security-headers.conf;

    # Server-level denial also covers ^~ prefixes; allow /.well-known/ paths.
    if ($uri ~ "/\.(?!well-known/)") { return 404; }

    # Block direct .gz downloads. gzip_static reads $uri.gz on disk without
    # changing $uri, so regular asset and page URLs still serve precompressed files.
    if ($uri ~ "\.gz$") { return 404; }

    absolute_redirect off;
    port_in_redirect off;

    location = /admin {
      return 301 /admin/;
    }

    location ^~ /_assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location ^~ /fonts/ {
      add_header Cache-Control "public, max-age=31536000";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    # Belt-and-braces regex before photo extensions; the server-level if denies first.
    location ~ "/\.(?!well-known/)" { return 404; }

    location ~* ^/photos/.+\.(?:avif|webp|jpe?g|png)$ {
      # URL versioning (?v=...) also needs image pipeline and consumer changes.
      add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location = /favicon.svg {
      add_header Cache-Control "public, max-age=86400";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location = /logo.svg {
      add_header Cache-Control "public, max-age=86400";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location = /robots.txt {
      add_header Cache-Control "public, max-age=86400";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location ~ ^/sitemap[^/]*\.xml$ {
      add_header Cache-Control "public, max-age=86400";
      include /app/docker/nginx-security-headers.conf;
      try_files $uri =404;
    }

    location /admin/ {
      proxy_pass http://127.0.0.1:3001;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
    }

    location /api/ {
      proxy_pass http://127.0.0.1:3001;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
    }

    location = /site-config.json {
      proxy_pass http://127.0.0.1:3001;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
    }

    location / {
      try_files $uri $uri.html $uri/index.html =404;
      add_header Cache-Control "no-cache" always;
      # Keep this complete set inline: the shared snippet uses DENY, not SAMEORIGIN.
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';" always;
    }

    location = /404 { return 404; }

    error_page 404 /404.html;
    location = /404.html {
      internal;
      # Error responses need the same complete page headers, including CSP.
      add_header Cache-Control "no-cache" always;
      add_header X-Frame-Options "SAMEORIGIN" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';" always;
    }
  }
}
