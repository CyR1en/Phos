---
import '../styles/global.css'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import SmoothScroll from '@components/SmoothScroll.astro'
import config from '@lib/config'
import { ClientRouter } from 'astro:transitions'

export interface Props {
  title: string
  description?: string
  image?: string
  page?: string
  type?: string
}

const { title, description, image, page, type = 'website' } = Astro.props

const themeFiles = Object.keys(import.meta.glob('../styles/themes/*.css'))
const themes = new Set(themeFiles.map(path => `theme-${path.slice(path.lastIndexOf('/') + 1, -4)}`))
const theme = themes.has(config.site.theme) ? config.site.theme : 'theme-gallery'

const pageTitle = title && title !== config.site.title
  ? (config.site.title ? `${title} | ${config.site.title}` : title)
  : (config.site.title || 'Photography')

const siteUrl = import.meta.env.PUBLIC_SITE_URL
const canonical = siteUrl ? `${siteUrl}/${page || ''}` : undefined

const configOg = config.site?.og
const resolveUrl = (path: string) => siteUrl ? `${siteUrl}${path}` : undefined
const ogImage = image
  ? (image.startsWith('http') ? image : resolveUrl(image))
  : (configOg?.image ? resolveUrl(configOg.image) : undefined)

const ogDescription = description || config.site.description

const socialLinks = config.site?.social || []
const twitterLink = socialLinks.find(s => s.platform === 'twitter')
const twitterHandle = twitterLink ? (() => {
  const m = twitterLink.url.match(/(?:twitter\.com|x\.com)\/([^/?]+)/)
  return m ? `@${m[1]}` : ''
})() : ''
const configTwitter = twitterHandle ? { site: twitterHandle, creator: twitterHandle } : null

const ogImageAlt = (image && configOg?.imageAlt) ? configOg.imageAlt : undefined

const imageMimeType = (url: string | undefined) => {
  if (!url) return undefined
  const ext = url.split('.').pop()?.split('?')[0]?.toLowerCase()
  const mimes: Record<string, string> = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', avif: 'image/avif', gif: 'image/gif' }
  return mimes[ext || ''] || undefined
}
---

<!DOCTYPE html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title data-config="site.title">{pageTitle}</title>
    <meta name="description" content={ogDescription} data-config="site.description" data-config-attr="content" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} data-config="site.title" data-config-attr="content" />
    <meta property="og:description" content={ogDescription} data-config="site.description" data-config-attr="content" />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content={configOg?.locale || 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && configOg?.imageWidth && <meta property="og:image:width" content={configOg.imageWidth.toString()} />}
    {ogImage && configOg?.imageHeight && <meta property="og:image:height" content={configOg.imageHeight.toString()} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && <meta property="og:image:type" content={imageMimeType(ogImage)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {configTwitter?.site && <meta name="twitter:site" content={configTwitter.site} />}
    {configTwitter?.creator && <meta name="twitter:creator" content={configTwitter.creator} />}

    <link rel="preload" href="/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function() {
        // 1. Apply dark mode immediately from localStorage / system preference (no FOUC)
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        } catch(e) {}

        // Cached live theme — survives client-side navigations without a network round-trip
        var _liveTheme = null;

        // 2. Fetch live config to apply the admin-chosen colour theme + data-config bindings
        function fetchAndApply() {
          fetch('/site-config.json', { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : null })
            .then(function(cfg) { if (cfg) applyConfig(cfg); })
            .catch(function() {});
        }

        // Public theme changes take effect after the next build, which the admin can trigger.
        // Only admin preview uses live config; public pages keep their baked theme and text.
        function isPreview() {
          return window.self !== window.top || new URLSearchParams(location.search).has('preview')
        }

        function applyParentTheme() {
          try {
            if (window.self === window.top) return null
            var p = window.parent.document.documentElement
            var t = p.getAttribute('data-theme')
            if (t) document.documentElement.setAttribute('data-theme', t)
            document.documentElement.classList.toggle('dark', p.classList.contains('dark'))
            return t
          } catch (e) {}
          return null
        }

        if (isPreview()) {
          applyParentTheme()
          // The public bundle ships one palette; the preview may switch to any of them.
          if (!document.querySelector('link[data-themes-all]')) {
            var themesWritten = false
            if (document.readyState === 'loading') {
              try {
                document.write('<link rel="stylesheet" href="/themes-all.css" data-themes-all>')
                themesWritten = true
              } catch (e) {}
            }
            if (!themesWritten) {
              var allThemes = document.createElement('link')
              allThemes.rel = 'stylesheet'
              allThemes.href = '/themes-all.css'
              allThemes.setAttribute('data-themes-all', '')
              document.head.appendChild(allThemes)
            }
          }
          document.addEventListener('astro:before-swap', function(e) {
            var head = e.newDocument && e.newDocument.head
            if (!head || head.querySelector('link[data-themes-all]')) return
            var next = e.newDocument.createElement('link')
            next.rel = 'stylesheet'
            next.href = '/themes-all.css'
            next.setAttribute('data-themes-all', '')
            head.appendChild(next)
          })
          // Re-apply the correct theme after Astro client-side navigation swaps <html> attrs.
          document.addEventListener('astro:after-swap', function() {
            if (!isPreview()) return
            var theme = applyParentTheme() || _liveTheme
            if (theme) {
              document.documentElement.setAttribute('data-theme', theme)
            }
            fetchAndApply()
          })

          fetchAndApply()
        }

        function applyConfig(cfg) {
          // Sync dark-mode class so it matches the current theme state
          try {
            var dm = localStorage.getItem('theme');
            if (dm === 'dark' || (dm !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          } catch(e) {}

          // The admin's unsaved palette choice takes precedence over live config.
          var theme = applyParentTheme() || (cfg.site && cfg.site.theme)
          if (theme) {
            _liveTheme = theme
            document.documentElement.setAttribute('data-theme', theme)
          }

          // Only apply data-config bindings if the page has them
          if (document.querySelector('[data-config]') === null) return;

          var els = document.querySelectorAll('[data-config]');
          for (var i = 0; i < els.length; i++) {
            var el = els[i];
            var path = el.getAttribute('data-config');
            var value = resolve(cfg, path);
            if (value === undefined || value === null) continue;
            if (typeof value === 'object') continue;
            if (String(value).trim() === '') continue;
            if (el.tagName === 'TITLE') {
              if (String(value).trim()) el.textContent = value;
            } else if (el.tagName === 'META') {
              var attr = el.getAttribute('data-config-attr') || 'content';
              el.setAttribute(attr, value);
            } else if (el.tagName === 'A' || el.tagName === 'LINK') {
              var hrefAttr = el.getAttribute('data-config-attr') || 'href';
              el.setAttribute(hrefAttr, value);
            } else {
              el.textContent = value;
            }
          }
        }

        function resolve(obj, path) {
          if (!obj) return undefined;
          var parts = path.split('.');
          var cur = obj;
          for (var i = 0; i < parts.length; i++) {
            if (cur == null) return undefined;
            cur = cur[parts[i]];
          }
          return cur;
        }
      })();
    </script>
  </head>
  <body class="public-site grain-bg flex min-h-[100dvh] flex-col bg-canvas text-ink antialiased">
    <SmoothScroll />
    <Header />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer />

  </body>
</html>
