---
import BaseLayout from '@layouts/BaseLayout.astro'
import Hero from '@components/Hero.astro'
import Services from '@components/Services.astro'
import Testimonials from '@components/Testimonials.astro'
import CTA from '@components/CTA.astro'
import CategoryCard from '@components/CategoryCard.astro'
import SelectedWork from '@components/SelectedWork.astro'
import Lightbox from '@components/Lightbox.astro'
import ImmersiveScrollGallery from '@components/ui/immersive-scroll-gallery'
import manifest from '@lib/categories'
import config from '@lib/config'
import type { PhotoPosition } from '@lib/admin/types'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}

const { categories } = manifest
const heroPriority: Array<(typeof manifest.heroPriority)[number] & { ogImage?: string }> = manifest.heroPriority
const sw = config.home.selectedWork || {}
const allPhotos = categories.flatMap(category => category.photos.map(photo => ({ ...photo, category: category.slug })))
const photoByKey = new Map<string, (typeof allPhotos)[number]>(allPhotos.map(photo => [`${photo.category}/${photo.filename}`, photo] as const))
const resolvePhotos = (keys: string[]) => keys.flatMap(key => {
  const photo = photoByKey.get(key)
  return photo ? [photo] : []
})
const immersive = config.home.immersiveGallery
// Remove missing keys with their matching positions so surviving photos keep their layout.
const filterImmersiveLayout = (photos: string[] = [], positions?: PhotoPosition[] | null) => {
  const entries = photos.map((key, index) => ({ key, index })).filter(({ key }) => photoByKey.has(key))
  return {
    photos: entries.map(({ key }) => key),
    positions: positions ? entries.map(({ index }) => positions[index]) : null,
  }
}
const { photos: desktopPhotos, positions: desktopPositions } = filterImmersiveLayout(immersive?.desktopPhotos, immersive?.desktopPositions)
const { photos: mobilePhotos, positions: mobilePositions } = filterImmersiveLayout(immersive?.mobilePhotos, immersive?.mobilePositions)
const immersiveSources = Object.fromEntries([...desktopPhotos, ...mobilePhotos].flatMap(key => {
  const photo = photoByKey.get(key)
  return photo ? [[key, { thumb: photo.thumb, immersive: photo.immersive, immersiveMobile: photo.immersiveMobile }]] : []
}))
const configuredImmersiveText = immersive?.text?.trim() || ''
const immersiveText = /^lorem/i.test(configuredImmersiveText) ? '' : configuredImmersiveText
const auto = [
  ...heroPriority.flatMap(hero => allPhotos.filter(photo => photo.category === hero.category && photo.full === hero.full).slice(0, 1)),
  ...[...categories].sort((a, b) => a.order - b.order).flatMap(category => resolvePhotos(category.photos.slice(0, 2).map(photo => `${category.slug}/${photo.filename}`))),
]
const selectedCandidates = [resolvePhotos(sw.photos || []), resolvePhotos(immersive?.desktopPhotos || [])]
  .find(list => list.length >= 3) ?? auto
const selected = [...new Map(selectedCandidates.map(photo => [`${photo.category}/${photo.filename}`, photo] as const)).values()].slice(0, 9)
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321'
const ogImage = config.site?.og?.image || heroPriority[0]?.ogImage || heroPriority[0]?.full
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: config.about.photographer.name,
  description: config.site.description,
  url: siteUrl,
  image: ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`) : undefined,
}

const ogTitle = config.home?.og_title || config.site.title
const ogDescription = config.home?.og_description || config.site.description
const defaultLayout = ['subheading', 'selectedWork', 'showcase', 'immersiveGallery', 'services', 'testimonials', 'cta']
const layout = [...new Set(config.home.layout || defaultLayout)]
// Older saved layouts may predate known sections; preserve their existing order.
for (const section of defaultLayout) {
  if (layout.includes(section) || section === 'immersiveGallery') continue
  if (section === 'selectedWork') {
    layout.splice(layout.indexOf('subheading') + 1, 0, section)
  } else {
    layout.push(section)
  }
}
if (!layout.includes('immersiveGallery')) layout.push('immersiveGallery')
---

<BaseLayout title={ogTitle} description={ogDescription} image={ogImage}>
  <Hero heroPriority={heroPriority} />

  {layout.map((sectionName: string) => {
    if (sectionName === 'subheading' && config.home.hero.subheading) {
      return (
        <section data-animate class="animate-reveal py-[calc(var(--spacing-section)/2)]">
          <div class="mx-auto max-w-2xl px-6 text-center">
            <p class="text-lead text-body-muted" data-config="home.hero.subheading">{config.home.hero.subheading}</p>
          </div>
        </section>
      )
    }

    if (sectionName === 'selectedWork' && sw.enabled !== false && selected.length >= 3) {
      return <SelectedWork photos={selected} heading={sw.heading || 'Selected work'} />
    }

    if (sectionName === 'services' && config.home.services.enabled !== false) {
      return <Services />
    }

    if (sectionName === 'immersiveGallery' && immersive?.enabled && desktopPhotos.length) {
      return (
        <div class="immersive-gallery relative h-[200vh] motion-reduce:h-auto">
          <ImmersiveScrollGallery
            client:only="preact"
            sources={immersiveSources}
            mobilePhotos={mobilePhotos}
            mobilePositions={mobilePositions}
            desktopPhotos={desktopPhotos}
            desktopPositions={desktopPositions}
            text={immersiveText}
          >
            <div slot="fallback" class="mx-auto max-w-6xl px-6 py-12">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 items-start gap-4">
                {resolvePhotos(desktopPhotos.slice(0, 6)).map(photo => (
                  <img src={photo.thumb} alt={photo.title || ''} width={photo.width} height={photo.height} class="block w-full h-auto" loading="lazy" decoding="async" />
                ))}
              </div>
              {immersiveText && <h2 class="max-w-3xl mx-auto text-ink text-2xl md:text-4xl py-8 font-display text-center" data-config="home.immersiveGallery.text">{immersiveText}</h2>}
            </div>
          </ImmersiveScrollGallery>
        </div>
      )
    }

    if (sectionName === 'showcase' && config.home.showcase?.enabled !== false) {
      return (() => {
        const showcase = config.home.showcase || { heading: 'Showcase', items: [] }
        const configured = showcase.items || []
        const sourceItems = configured.length === 0
          ? categories.map((c: any) => ({ type: 'category', slug: c.slug }))
          : configured
        const items = sourceItems.map((item: any) => {
          if (item.type === 'gallery') {
            const gal = galleries.find((g: any) => g.slug === item.slug)
            if (!gal) return null
            return {
              name: gal.name,
              slug: gal.slug,
              description: gal.description,
              cover: gal.cover,
              coverSrcset: gal.coverSrcset || '',
              coverWidth: gal.coverWidth ?? null,
              coverHeight: gal.coverHeight ?? null,
              coverFocus: gal.coverFocus,
              photoCount: gal.photoCount,
              blur: gal.coverBlur,
              link: `/galleries/${gal.slug}/`,
              actionLabel: 'View gallery',
              displayTitle: item.title || undefined,
              displayDescription: item.description !== undefined ? item.description : undefined,
            }
          }
          const cat: any = categories.find((c: any) => c.slug === item.slug)
          if (!cat) return null
          return {
            name: cat.name,
            slug: cat.slug,
            description: cat.description,
            cover: cat.cover,
            coverSrcset: cat.coverSrcset || '',
            coverWidth: cat.coverWidth,
            coverHeight: cat.coverHeight,
            coverFocus: cat.coverFocus,
            photoCount: cat.photoCount,
            blur: cat.coverBlur,
            link: `/photos/all/?cat=${cat.slug}`,
            actionLabel: 'View photos',
            displayTitle: item.title || undefined,
            displayDescription: item.description !== undefined ? item.description : undefined,
          }
        }).filter(Boolean)

        if (items.length === 0) return null

        return (
          <section id="showcase" class="showcase-section" aria-labelledby="showcase-heading">
            <div class="mx-auto w-full max-w-wide px-6 lg:px-8">
              <div class="showcase-header">
                <div data-animate-header>
                  <h2 id="showcase-heading" class="section-heading font-display text-ink" data-config="home.showcase.heading">{showcase.heading}</h2>
                </div>
                <a href="/photos/all/" class="showcase-browse">Browse all photos</a>
              </div>

              <div class="showcase-list">
                {items.map((item: any) => (
                  <CategoryCard
                    name={item.name}
                    slug={item.slug}
                    description={item.description}
                    cover={item.cover}
                    coverSrcset={item.coverSrcset || undefined}
                    coverWidth={item.coverWidth}
                    coverHeight={item.coverHeight}
                    coverFocus={item.coverFocus ?? undefined}
                    photoCount={item.photoCount}
                    blur={item.blur}
                    link={item.link}
                    displayTitle={item.displayTitle}
                    displayDescription={item.displayDescription}
                    actionLabel={item.actionLabel}
                  />
                ))}
              </div>
            </div>
          </section>
        )
      })()
    }

    if (sectionName === 'testimonials' && config.home.testimonials.enabled !== false) {
      return <Testimonials />
    }

    if (sectionName === 'cta' && config.home.cta.enabled !== false) {
      return (
        <CTA
          heading={config.home.cta.heading}
          body={config.home.cta.body}
          buttonText={config.home.cta.button}
          configPrefix="home.cta"
          configButtonKey="button"
        />
      )
    }

    return null
  })}

  {sw.enabled !== false && selected.length >= 3 && <Lightbox photos={selected} />}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
