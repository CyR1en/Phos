---
import BaseLayout from '@layouts/BaseLayout.astro'
import config from '@lib/config'
import Plugins from '@components/Plugins.astro'
import CTA from '@components/CTA.astro'

const aboutPhoto = config.about.photographer?.photo || ''
const gear = config.about.gear || {}
const gearLabel = gear.heading || 'My Gear'
const gearList = gear.equipment || []
const hasGear = gearList.length > 0
const bio = config.about.photographer?.bio || ''
const BIO_WORD_LIMIT = 250
const bioParagraphs = bio.split(/\r?\n\s*\r?\n/).map(para => para.trim()).filter(Boolean)
let bioWordCount = 0
let visibleParagraphCount = 0
for (const paragraph of bioParagraphs) {
  const paragraphWords = paragraph.split(/\s+/).length
  if (visibleParagraphCount > 0 && bioWordCount + paragraphWords > BIO_WORD_LIMIT) break
  bioWordCount += paragraphWords
  visibleParagraphCount++
}
const truncatedBio = bioParagraphs.slice(0, visibleParagraphCount)
const remainingBio = bioParagraphs.slice(visibleParagraphCount)
const bioExceedsLimit = remainingBio.length > 0
const cta = config.about.call_to_action
const ogTitle = config.about?.og_title || 'About'
const ogDescription = config.about?.og_description
---

<BaseLayout title={ogTitle} description={ogDescription}>
  <section data-animate class:list={[
    'animate-reveal',
    aboutPhoto ? 'flex flex-col lg:flex-row' : 'mx-auto w-full max-w-text px-6 lg:px-8',
  ]}>
    {aboutPhoto && (
      <div class="relative aspect-[4/5] sm:aspect-[3/2] lg:aspect-auto lg:h-[calc(100dvh-var(--site-header-height))] w-full lg:w-1/2 shrink-0 overflow-hidden lg:sticky lg:top-[var(--site-header-height)]">
        <img
          src={aboutPhoto}
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    <div class:list={[
      'about-content relative min-w-0 flex-1 flex items-center',
      { 'px-6 lg:px-12 xl:px-16': aboutPhoto },
    ]}>
      <div class="w-full" data-animate-header>
        <p class="eyebrow">About</p>
        <h1 class="mt-6 text-h1 font-display text-ink" data-config="about.photographer.name">
          {config.about.photographer.name}
        </h1>
        <p class="about-intro mt-6 text-lead text-body-muted" data-config="about.photographer.intro">
          {config.about.photographer.intro}
        </p>
        {bio.trim() && (
          <div class="mt-8 space-y-5 max-w-[62ch] text-base lg:text-[1.0625rem] leading-relaxed text-body-muted" id="bio-container">
            {bioExceedsLimit ? (
              <>
                <div id="bio-truncated" class="space-y-5">
                  {truncatedBio.map((para) => (
                    <p>{para}</p>
                  ))}
                </div>
                <details class="bio-more">
                  <summary class="bio-more-summary">
                    <span class="bio-more-open">Read more</span>
                    <span class="bio-more-close">Show less</span>
                  </summary>
                  <div class="space-y-5">
                    {remainingBio.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              </>
            ) : (
              <>
                {bioParagraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  {hasGear && (
    <section data-animate class="about-equipment animate-reveal">
      <div class="mx-auto max-w-text px-6 lg:px-8">
        <div data-animate-header>
          <p class="eyebrow">Equipment</p>
          <h2 class="mt-4 text-h2 font-display text-ink" data-config="about.gear.heading">
            {gearLabel}
          </h2>
        </div>
        <ul class="mt-8 grid sm:grid-cols-2 gap-x-12">
          {gearList.map((item) => (
            <li class="py-4 border-t border-border text-base text-ink">{item}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Plugins name="about.after-gear" />

  {cta && (
    <CTA
        heading={cta.heading}
        buttonText={cta.link}
        configPrefix="about.call_to_action"
        configButtonKey="link"
    />
  )}
</BaseLayout>

<style>
  .about-content,
  .about-equipment {
    padding-block: calc(var(--spacing-section) / 2);
  }

  .about-intro::first-letter {
    text-transform: uppercase;
  }

  .bio-more-summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    list-style: none;
  }

  .bio-more-summary:hover {
    text-decoration: none;
  }

  .bio-more-summary::-webkit-details-marker {
    display: none;
  }

  .bio-more-close,
  .bio-more[open] .bio-more-open {
    display: none;
  }

  .bio-more[open] .bio-more-close {
    display: inline;
  }
</style>
