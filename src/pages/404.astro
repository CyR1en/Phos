---
import BaseLayout from '@layouts/BaseLayout.astro'
import config from '@lib/config'
const ogTitle = config.notFound?.og_title || config.notFound.heading
const ogDescription = config.notFound?.og_description
---

<BaseLayout title={ogTitle} description={ogDescription}>
  <section class="mx-auto flex min-h-[80vh] max-w-wide flex-col items-start justify-center px-6 lg:px-8">
    <div data-animate-header class="flex flex-col items-start">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-6 font-display text-h1 text-ink" data-config="notFound.heading">{config.notFound.heading}</h1>
      <p class="mt-6 text-lead text-body-muted max-w-[52ch]" data-config="notFound.message">{config.notFound.message}</p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href="/photos/all/" class="site-button inline-flex items-center rounded-pill bg-primary text-primary-text hover:bg-primary-hover">
          <span data-config="notFound.button">{config.notFound.button || 'View photographs'}</span>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/" class="text-sm text-ink underline underline-offset-4">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(36px, 7vw, 72px);
  }
</style>
