---
import { Dashboard } from '../../components/admin/Dashboard.tsx'
import '../../styles/global.css'
import '../../styles/admin.css'
---

<!DOCTYPE html>
<html lang="en" class="bg-canvas text-ink" data-theme="theme-rose-pine">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Admin | Phos</title>
    <link rel="preload" href="/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        if (stored === 'dark' || (stored !== 'light' && mq.matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        fetch('/site-config.json', { credentials: 'same-origin' })
          .then(function(r) { return r.ok ? r.json() : null })
          .then(function(cfg) {
            if (cfg && cfg.site && cfg.site.theme) {
              document.documentElement.setAttribute('data-theme', cfg.site.theme);
            }
          })
          .catch(function() {});
      })();
    </script>
  </head>
  <body class="admin-app font-body antialiased">
    <div id="admin-root">
      <a
        href="#admin-main"
        class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:bg-surface focus:text-ink focus:rounded-sm focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-border-focus"
      >
        Skip to content
      </a>
      <Dashboard client:only="preact" />
    </div>

    <script>
      import 'preline';
    </script>
  </body>
</html>
