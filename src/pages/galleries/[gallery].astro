---
import BaseLayout from '@layouts/BaseLayout.astro'
import PhotoGallery from '@components/Gallery.astro'
import Lightbox from '@components/Lightbox.astro'
import PageHeader from '@components/PageHeader.astro'

const PHOTO_CONTAINER = 'mx-auto w-full max-w-[1760px] px-[clamp(16px,3vw,48px)]'
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`

export async function getStaticPaths() {
  let galleries: any[] = []
  try {
    const gals = await import('@lib/galleries').then(m => m.default || m)
    galleries = gals.galleries || []
  } catch {
    galleries = []
  }

  return galleries.map((gallery) => ({
    params: { gallery: gallery.slug },
    props: { gallery },
  }))
}

const { gallery } = Astro.props

const photos = gallery.photos.map((p: any) => ({ ...p, category: p.category }))

const siteUrl = import.meta.env.PUBLIC_SITE_URL || ''
const ogImage = gallery.coverOg ? `${siteUrl}${gallery.coverOg}` : gallery.coverFull ? `${siteUrl}${gallery.coverFull}` : undefined
---

<BaseLayout title={gallery.name} description={gallery.description} image={ogImage} page={`galleries/${gallery.slug}`} type="article">
  <PageHeader
    backHref="/galleries/"
    backLabel="Galleries"
    title={gallery.name}
    meta={plural(gallery.photoCount, 'photo')}
    description={gallery.description}
    containerClass={PHOTO_CONTAINER}
  />

  <section class={PHOTO_CONTAINER} style="padding-bottom: var(--spacing-section)">
    <PhotoGallery photos={photos} />
  </section>

  <Lightbox photos={photos} />
</BaseLayout>
