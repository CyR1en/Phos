---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import manifest from '@lib/categories'
import config from '@lib/config'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}

const hasGalleries = galleries.length > 0
const cards = hasGalleries
  ? galleries.map((gallery) => ({
    href: `/galleries/${gallery.slug}/`,
    name: gallery.name,
    description: gallery.description,
    cover: gallery.cover,
    coverSrcset: gallery?.coverSrcset,
    coverWidth: gallery?.coverWidth,
    coverHeight: gallery?.coverHeight,
    coverFocus: gallery.coverFocus,
    blur: gallery.coverBlur,
    photoCount: gallery.photoCount,
  }))
  : (manifest.categories || []).map((category: any) => ({
    href: `/photos/all/?cat=${category.slug}`,
    name: category.name,
    description: category.description,
    cover: category.cover,
    coverSrcset: category?.coverSrcset,
    coverWidth: category?.coverWidth,
    coverHeight: category?.coverHeight,
    coverFocus: category.coverFocus,
    blur: category.coverBlur,
    photoCount: category.photoCount,
  }))

// Capped: (1536px container - 64px padding - 2 × 32px gaps) / 3 ≈ 469px.
// XL: (viewport - 64px padding - 2 × 2vw gaps) / 3; SM: (viewport - 48px padding - 2vw gap) / 2.
const cardSizes = '(min-width: 1536px) 469px, (min-width: 1280px) calc((100vw - 64px - 4vw) / 3), (min-width: 640px) calc((100vw - 48px - 2vw) / 2), calc(100vw - 48px)'
const plural = (n: number, word: string, pluralWord = `${word}s`) => `${n} ${n === 1 ? word : pluralWord}`

const ogTitle = config.portfolio?.og_title || 'Portfolio'
const ogDescription = config.portfolio?.og_description
---

<BaseLayout title={ogTitle} description={ogDescription} page="galleries">
  <PageHeader
    eyebrow="Portfolio"
    title="Galleries"
    meta={hasGalleries ? plural(cards.length, 'gallery', 'galleries') : plural(cards.length, 'category', 'categories')}
  />

  <section class="mx-auto w-full max-w-wide px-6 pb-[calc(var(--spacing-section)/2)] lg:px-8">
    {cards.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-lg text-muted mb-6">No galleries yet.</p>
        <a
          href="/photos/all/"
          class="inline-flex items-center rounded-pill bg-primary px-6 py-3 text-sm font-medium text-primary-text hover:bg-primary-hover transition-colors"
        >
          Browse all photos
          <svg class="ml-2 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-[clamp(16px,2vw,32px)] gap-y-[clamp(40px,5vw,72px)]">
        {cards.map((card) => (
          <a
            href={card.href}
            class="gallery-card group block"
          >
            <div
              class="aspect-[4/5] overflow-hidden rounded-photo bg-surface bg-cover bg-center"
              style={card.blur ? `background-image:url('${card.blur}')` : undefined}
            >
              {card.cover && (
                <img
                  src={card.cover}
                  srcset={card.coverSrcset || undefined}
                  sizes={card.coverSrcset ? cardSizes : undefined}
                  width={card.coverWidth || undefined}
                  height={card.coverHeight || undefined}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                  style={card.coverFocus ? `object-position:${card.coverFocus}` : undefined}
                />
              )}
            </div>
            <h2 class="mt-4 text-h3 font-display text-ink">{card.name}</h2>
            <p class="eyebrow mt-2">{plural(card.photoCount, 'photo')}</p>
            {card.description && (
              <p class="mt-2 text-sm text-body-muted max-w-[44ch] line-clamp-2">{card.description}</p>
            )}
          </a>
        ))}
      </div>
    )}
  </section>

  {hasGalleries && (
    <section class="mx-auto w-full max-w-wide px-6 pb-[calc(var(--spacing-section)/2)] lg:px-8 flex justify-end">
      <a href="/photos/all/" class="showcase-browse">Browse all photos →</a>
    </section>
  )}
</BaseLayout>
