---
import BaseLayout from '@layouts/BaseLayout.astro'
import config from '@lib/config'

const { heading, subheading, submitBtn } = config.contact.format
const { host, port, user, pass, fromEmail, toEmail } = config.contact.smtp
const hasSmtp = Boolean(host && port && user && pass && fromEmail && toEmail)
const email = config.about.photographer?.email || ''
const social = (config.site.social || []).filter(item => item.platform && item.url)
const ogTitle = config.contact?.og_title || config.contact.format.heading
const ogDescription = config.contact?.og_description
---

<BaseLayout title={ogTitle} description={ogDescription}>
  <section class="contact-bleed flex flex-1 flex-col justify-center">
    <div class:list={[
      'mx-auto w-full max-w-wide px-6 lg:px-8',
      { 'grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20': hasSmtp },
    ]}>
      <div class:list={['min-w-0', { 'max-w-text': !hasSmtp }]}>
        <div data-animate-header class="opacity-0">
          <p class="eyebrow">Contact</p>
          <h1 class="mt-4 text-h1 font-display text-ink" data-config="contact.format.heading">{heading}</h1>
          <p class="mt-6 text-lead text-body-muted max-w-[44ch]" data-config="contact.format.subheading">
            {subheading}
          </p>
        </div>

        {(email || social.length > 0) && (
          <ul class="mt-8 space-y-3 text-base">
            {email && (
              <li>
                <a href={`mailto:${email}`} class="break-words text-ink underline decoration-border underline-offset-4 hover:decoration-ink transition-colors">{email}</a>
              </li>
            )}
            {social.map(item => (
              <li>
                <a href={item.url} class="text-ink capitalize underline decoration-border underline-offset-4 hover:decoration-ink transition-colors">{item.platform}</a>
              </li>
            ))}
            {!hasSmtp && email && (
              <li class="pt-3">
                <a href={`mailto:${email}`}
                  class="site-button inline-flex items-center rounded-pill bg-primary text-primary-text hover:bg-primary-hover"
                >Email me
                  <svg class="ml-2 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </li>
            )}
          </ul>
        )}
      </div>

      {hasSmtp && (
        <>
          <form id="contact-form" class="grid w-full max-w-xl gap-4 sm:grid-cols-2 sm:gap-8">
            <div>
              <label for="name" class="block text-[13px] font-medium tracking-[.02em] text-ink">Name</label>
              <input
                type="text" id="name" name="name" required
                class="mt-2 block w-full rounded-sm border border-[var(--color-border-input)] bg-canvas px-4 py-3 text-base text-ink placeholder:text-muted focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-border-focus/20 transition-shadow"
              />
            </div>

            <div>
              <label for="email" class="block text-[13px] font-medium tracking-[.02em] text-ink">Email</label>
              <input
                type="email" id="email" name="email" required
                class="mt-2 block w-full rounded-sm border border-[var(--color-border-input)] bg-canvas px-4 py-3 text-base text-ink placeholder:text-muted focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-border-focus/20 transition-shadow"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="message" class="block text-[13px] font-medium tracking-[.02em] text-ink">Message</label>
              <textarea
                id="message" name="message" rows="5" required
                class="mt-2 block w-full rounded-sm border border-[var(--color-border-input)] bg-canvas px-4 py-3 text-base text-ink placeholder:text-muted focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-border-focus/20 transition-shadow resize-y"
              ></textarea>
            </div>

            <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
              <button type="submit"
                class="site-button inline-flex items-center rounded-pill bg-primary text-primary-text hover:bg-primary-hover"
              ><span data-config="contact.format.submitBtn">{submitBtn}</span>
                <svg class="ml-2 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>

            <div id="form-status" role="status" aria-live="polite" class="sm:col-span-2 rounded-sm text-sm sr-only"></div>
          </form>

          <script>
            function initContactForm() {
              const form = document.getElementById('contact-form') as HTMLFormElement | null
              if (!form || form.dataset.bound) return

              const status = document.getElementById('form-status')!
              const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
              const originalBtnText = btn.textContent || ''
              form.dataset.bound = 'true'

              form.addEventListener('submit', async (e) => {
                e.preventDefault()
                status.className = 'sm:col-span-2 rounded-sm text-sm sr-only'
                status.textContent = ''
                btn.disabled = true
                const labelEl = btn.querySelector('span')
                if (labelEl) labelEl.textContent = 'Sending...'

                const formData = new FormData(form)

                try {
                  const res = await fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      name: formData.get('name'),
                      email: formData.get('email'),
                      message: formData.get('message'),
                    }),
                  })

                  const data = await res.json()

                  if (!res.ok) {
                    throw new Error(data.error || `Submission failed (${res.status})`)
                  }

                  status.className = 'sm:col-span-2 rounded-sm text-sm p-4 bg-success-bg text-ink'
                  status.textContent = 'Message sent! I\'ll get back to you soon.'
                  form.reset()
                } catch (err: any) {
                  status.className = 'sm:col-span-2 rounded-sm text-sm p-4 bg-error-bg text-error'
                  status.textContent = err.message || 'Something went wrong. Please try again.'
                } finally {
                  btn.disabled = false
                  if (labelEl) labelEl.textContent = originalBtnText
                }
              })
            }

            initContactForm()
            document.addEventListener('astro:page-load', initContactForm)
          </script>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .contact-bleed {
    padding-block: calc(var(--spacing-section) / 2);
  }
</style>
