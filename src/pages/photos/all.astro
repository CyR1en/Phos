---
import BaseLayout from '@layouts/BaseLayout.astro'
import PhotoGrid from '@components/PhotoGrid.astro'
import Lightbox from '@components/Lightbox.astro'
import PageHeader from '@components/PageHeader.astro'
import manifest from '@lib/categories'

const { categories } = manifest
const PHOTO_CONTAINER = 'mx-auto w-full max-w-[1760px] px-[clamp(16px,3vw,48px)]'
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`

interface FlatPhoto {
  filename: string
  title: string
  full: string
  hd: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  srcset: string
  width: number | null
  height: number | null
  blur: string
  focus?: string | null
  category: string
  categoryName: string
}

const allPhotos: FlatPhoto[] = categories.flatMap((cat) =>
  cat.photos.map((p) => ({
    ...p,
    category: cat.slug,
    categoryName: cat.name,
  }))
)
---

<BaseLayout title="All Photos" description="Browse all photos across every category" page="photos/all">
  <PageHeader eyebrow="Browse" title="All photos" meta={plural(allPhotos.length, 'photo')} containerClass={PHOTO_CONTAINER}>
    <div slot="actions" id="filters" class="flex gap-2 flex-nowrap overflow-x-auto lg:flex-wrap lg:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <button type="button" class="filter-btn shrink-0 text-sm font-medium rounded-pill border border-primary bg-primary px-4 py-2 text-primary-text min-h-11 transition-colors" data-filter="all" aria-pressed="true">
        All
      </button>
      {categories.map((cat) => (
        <button type="button" class="filter-btn shrink-0 text-sm font-medium rounded-pill border border-border px-4 py-2 text-ink min-h-11 transition-colors" data-filter={cat.slug} aria-pressed="false">
          {cat.name}
        </button>
      ))}
    </div>
  </PageHeader>

  <section class={PHOTO_CONTAINER} style="padding-bottom: var(--spacing-section)">
    <PhotoGrid photos={allPhotos} wrapperClass="gallery-item" />

    <div id="empty-state" class="hidden py-24 text-center text-lg text-muted">
      No photos match the selected category.
    </div>
  </section>

  <Lightbox photos={allPhotos} />

  <script>
    const EASE_OUT_EXPO = getComputedStyle(document.documentElement).getPropertyValue('--ease-out-expo').trim() || 'cubic-bezier(.16,1,.3,1)'
    type LightboxPhotos = Parameters<NonNullable<Window['__updateLightboxData']>>[0]

    const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`

    function initFilters() {
      const filtersContainer = document.getElementById('filters')
      if (!filtersContainer || filtersContainer.dataset.bound) return

      const items = document.querySelectorAll<HTMLElement>('.gallery-item')
      const buttons = Array.from(filtersContainer.querySelectorAll<HTMLButtonElement>('.filter-btn'))
      const emptyState = document.getElementById('empty-state')
      const pageHeader = filtersContainer.closest('header')
      const pageTitle = pageHeader?.querySelector('[data-page-title]') || pageHeader?.querySelector('h1')
      const pageMeta = pageHeader?.querySelector('[data-page-meta]')
      const lightboxData = document.getElementById('lightbox-data')
      const fullData = JSON.parse(lightboxData?.textContent || '[]') as LightboxPhotos

      const urlParams = new URLSearchParams(window.location.search)
      const initialCat = urlParams.get('cat')

      function applyFilter(filter: string) {
        const activeBtn = buttons.find((button) => button.dataset.filter === filter)
          || buttons.find((button) => button.dataset.filter === 'all')
        const activeFilter = activeBtn?.dataset.filter || 'all'

        buttons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-text', 'border-primary')
          b.classList.add('border-border', 'text-ink')
          b.setAttribute('aria-pressed', 'false')
        })

        if (activeBtn) {
          activeBtn.classList.add('bg-primary', 'text-primary-text', 'border-primary')
          activeBtn.classList.remove('border-border', 'text-ink')
          activeBtn.setAttribute('aria-pressed', 'true')
        }

        const visibleItems: HTMLElement[] = []

        items.forEach((item) => {
          const matches = activeFilter === 'all' || item.dataset.category === activeFilter
          item.getAnimations().forEach((animation) => animation.cancel())
          item.dataset.animated = 'true'
          delete item.dataset.revealPending
          item.style.display = matches ? '' : 'none'
          if (matches) {
            item.dataset.index = String(visibleItems.length)
            visibleItems.push(item)
          } else {
            delete (item as HTMLElement).dataset.index
          }
        })

        emptyState?.classList.toggle('hidden', visibleItems.length > 0)
        if (pageTitle) {
          pageTitle.textContent = activeFilter === 'all' ? 'All photos' : activeBtn?.textContent?.trim() || 'All photos'
        }
        if (pageMeta) pageMeta.textContent = plural(visibleItems.length, 'photo')

        if (!document.documentElement.classList.contains('reveal-timeout') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          visibleItems
            .map((item) => ({ item, rect: item.getBoundingClientRect() }))
            .filter(({ rect }) => rect.top < window.innerHeight && rect.bottom > 0)
            .sort((a, b) => a.rect.top - b.rect.top || a.rect.left - b.rect.left)
            .slice(0, 12)
            .forEach(({ item }, index) => {
              item.animate(
                [
                  { opacity: 0, clipPath: 'inset(6% 0 0 0)' },
                  { opacity: 1, clipPath: 'inset(0)' },
                ],
                {
                  duration: 900,
                  easing: EASE_OUT_EXPO,
                  delay: Math.min(index * 60, 300),
                  fill: 'backwards',
                }
              )
            })
        }

        const filtered = activeFilter === 'all' ? fullData : fullData.filter((p) => p.category === activeFilter)
        if (window.__updateLightboxData) window.__updateLightboxData(filtered)
        else if (lightboxData) lightboxData.textContent = JSON.stringify(filtered)
        return activeFilter
      }

      // Use event delegation to avoid cloning nodes and losing references
      filtersContainer.dataset.bound = 'true'
      filtersContainer.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn')
        if (!btn) return

        const filter = applyFilter(btn.dataset.filter || 'all')
        const url = new URL(window.location.href)
        if (filter === 'all') url.searchParams.delete('cat')
        else url.searchParams.set('cat', filter)
        history.replaceState(history.state, '', url.toString())
      })

      if (initialCat) {
        applyFilter(initialCat)
      }
    }

    // Run immediately for initial load
    initFilters()

    // Run on subsequent navigations
    document.addEventListener('astro:after-swap', initFilters)
  </script>
</BaseLayout>
