---
import BaseLayout from '@layouts/BaseLayout.astro'
import PhotoGrid from '@components/PhotoGrid.astro'
import Lightbox from '@components/Lightbox.astro'
import manifest from '@lib/categories'
import config from '@lib/config'

const { categories } = manifest

interface FlatPhoto {
  filename: string
  title: string
  full: string
  thumb: string
  thumbMobile: string
  width: number | null
  height: number | null
  blur: string
  category: string
  categoryName: string
}

const allPhotos: FlatPhoto[] = categories.flatMap((cat) =>
  cat.photos.map((p) => ({
    ...p,
    category: cat.slug,
    categoryName: cat.name,
  }))
)
---

<BaseLayout title="All Photos" description="Browse all photos across every category" page="photos/all">
  <section class="pt-16 lg:pt-24 pb-8 lg:pb-12">
    <div class="mx-auto max-w-7xl px-6 sm:px-6 lg:px-8 opacity-0" data-animate-header>
      <p class="font-mono text-xs uppercase tracking-wider text-muted">Browse</p>
      <h1 class="mt-4 font-display text-ink">All photos</h1>
      <p class="mt-4 text-lg text-body-muted leading-relaxed">Every photo across all categories</p>
    </div>
  </section>

  <section class="mx-auto pb-16 lg:pb-24 max-w-7xl px-6 sm:px-6 lg:px-8">
    <div id="filters" class="mb-8 flex flex-wrap gap-2">
      <button class="filter-btn text-sm font-medium rounded-pill border border-primary bg-primary px-4 py-2 text-primary-text min-h-[36px] transition-colors" data-filter="all" aria-pressed="true">
        All
      </button>
      {categories.map((cat) => (
        <button class="filter-btn text-sm font-medium rounded-pill border border-border px-4 py-2 text-ink hover:border-primary min-h-[36px] transition-colors" data-filter={cat.slug} aria-pressed="false">
          {cat.name}
        </button>
      ))}
    </div>

    <PhotoGrid photos={allPhotos} wrapperClass="gallery-item" />

    <div id="empty-state" class="hidden py-24 text-center text-lg text-muted">
      No photos match the selected category.
    </div>
  </section>

  <Lightbox photos={allPhotos} />

  <script>
    import { animate, stagger } from 'framer-motion/dom'

    function initFilters() {
      const filtersContainer = document.getElementById('filters')
      const items = document.querySelectorAll('.gallery-item')
      const emptyState = document.getElementById('empty-state')
      const fullData = JSON.parse(document.getElementById('lightbox-data')?.textContent || '[]')

      const urlParams = new URLSearchParams(window.location.search)
      const initialCat = urlParams.get('cat')

      function applyFilter(filter: string) {
        // Update button states
        const currentBtns = document.querySelectorAll('.filter-btn')
        currentBtns.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-text', 'border-primary')
          b.classList.add('border-border', 'text-ink')
          b.setAttribute('aria-pressed', 'false')
        })

        const activeBtn = document.querySelector(`[data-filter="${filter}"]`) || document.querySelector('[data-filter="all"]')
        if (activeBtn) {
          activeBtn.classList.add('bg-primary', 'text-primary-text', 'border-primary')
          activeBtn.classList.remove('border-border', 'text-ink')
          activeBtn.setAttribute('aria-pressed', 'true')
        }

        let visible = 0
        let newIdx = 0
        const visibleItems: HTMLElement[] = []
        
        items.forEach((item) => {
          const matches = filter === 'all' || (item as HTMLElement).dataset.category === filter
          ;(item as HTMLElement).style.display = matches ? '' : 'none'
          if (matches) {
            visible++
            ;(item as HTMLElement).dataset.index = String(newIdx++)
            visibleItems.push(item as HTMLElement)
          }
        })

        emptyState?.classList.toggle('hidden', visible > 0)

        if (visibleItems.length > 0) {
          // Use Framer Motion keyframes to force the start state, avoiding manual style manipulation
          animate(
            visibleItems,
            { opacity: [0, 1], y: [24, 0] },
            {
              duration: 0.7,
              ease: [0.16, 1, 0.3, 1],
              delay: stagger(0.06),
            }
          )
        }

        const filtered = filter === 'all' ? fullData : fullData.filter((p: any) => p.category === filter)
        window.__updateLightboxData?.(filtered)
      }

      // Use event delegation to avoid cloning nodes and losing references
      if (filtersContainer && !filtersContainer.dataset.bound) {
        filtersContainer.dataset.bound = 'true'
        filtersContainer.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement | null
          if (!btn) return
          
          const filter = btn.dataset.filter || 'all'
          applyFilter(filter)
          
          const url = new URL(window.location.href)
          if (filter === 'all') url.searchParams.delete('cat')
          else url.searchParams.set('cat', filter)
          history.replaceState(null, '', url.toString())
        })
      }

      if (initialCat) {
        applyFilter(initialCat)
      }
    }

    // Run immediately for initial load
    initFilters()

    // Run on subsequent navigations
    document.addEventListener('astro:after-swap', initFilters)
  </script>
</BaseLayout>
