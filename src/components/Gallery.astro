---
import PhotoGrid from '@components/PhotoGrid.astro'

export interface Photo {
  filename: string
  title: string
  titleIsAuto?: boolean
  description?: string
  full: string
  hd: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  width: number | null
  height: number | null
  blur: string
  focus?: string | null
  category?: string
}

export interface Props {
  photos: Photo[]
}

const { photos } = Astro.props
---

<PhotoGrid photos={photos} />
