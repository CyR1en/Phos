---
export interface Props {
  heroPriority: Array<{
    full: string
    thumb: string
    hd: string
    srcset: string
    srcsetAvif?: string
    heroSrc?: string
    heroPortrait?: { srcset: string; srcsetAvif: string } | null
    ogImage?: string
    title: string
    titleIsAuto?: boolean
    description: string
    blur: string
    width: number | null
    height: number | null
    focus?: string | null
    category: string
    categoryName: string
    hero_priority: number
  }>
}

import config from '@lib/config'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}
const hasGalleries = galleries.length > 0

const { heroPriority } = Astro.props
const hasSlideshow = heroPriority.length > 1
const slideshowInterval = config.home.hero.slideshow_interval ?? 6000
const overlayOpacity = config.home.hero.overlay_opacity ?? 0.5
const kenBurns = config.home.hero.ken_burns ?? false
const parallax = config.home.hero.parallax ?? false

// Cover crops need enough resolution for the painted width, including on phones.
function heroSizes(photo: { width: number | null; height: number | null }) {
  if (!photo.width || !photo.height) return '100vw'
  return `(max-aspect-ratio: ${photo.width}/${photo.height}) ${Math.ceil((photo.width / photo.height) * 100)}vh, 100vw`
}

function photoCredit(photo: Props['heroPriority'][number]) {
  const title = photo.title.trim()
  // Older manifests lack title provenance, so retain their filename heuristic.
  const titleIsAuto = photo.titleIsAuto === undefined
    ? /^Sample \d+$/i.test(title) || /^(DSC|IMG)[ _-]?\d+/i.test(title)
    : photo.titleIsAuto
  const hasTitle = title && !titleIsAuto
  return [photo.categoryName, hasTitle ? title : ''].filter(Boolean).join(' · ')
}
---

<section
  class="photo-hero relative flex items-end justify-center overflow-hidden"
  data-hero-interval={slideshowInterval}
  data-hero-empty={heroPriority.length === 0 ? '' : undefined}
  data-ken-burns={kenBurns ? '' : undefined}
  data-parallax={parallax ? '' : undefined}
  aria-roledescription={hasSlideshow ? 'carousel' : undefined}
  aria-label={hasSlideshow ? 'Featured photographs' : undefined}
  style={`--hero-interval: ${slideshowInterval}ms; --hero-scrim: ${overlayOpacity}`}
>
  {heroPriority.length > 0 ? (
    <>
      <div class="absolute inset-0 z-0 pointer-events-none" id="hero-bg">
        {heroPriority.map((photo, i) => (
          <div
            class:list={['absolute inset-0 bg-cover bg-center hero-slide', i === 0 && 'is-active']}
            style={`background-image: url('${photo.blur}'); opacity: ${i === 0 ? 1 : 0}; z-index: ${i === 0 ? 1 : 0};${photo.focus ? ` background-position: ${photo.focus};` : ''}`}
            data-hero-slide={i}
            data-hero-label={photo.title}
            data-hero-credit-text={photoCredit(photo)}
            data-hero-credit-href={`/photos/all/?cat=${encodeURIComponent(photo.category)}`}
            role={i === 0 ? 'img' : undefined}
            aria-label={i === 0 ? photo.title : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            {i === 0 ? (
              <picture>
                {photo.heroPortrait && <source media="(max-aspect-ratio: 4/5)" type="image/avif" srcset={photo.heroPortrait.srcsetAvif} sizes={heroSizes({ width: 1290, height: 2000 })} />}
                {photo.heroPortrait && <source media="(max-aspect-ratio: 4/5)" type="image/webp" srcset={photo.heroPortrait.srcset} sizes={heroSizes({ width: 1290, height: 2000 })} />}
                {photo.srcsetAvif && <source type="image/avif" srcset={photo.srcsetAvif} sizes={heroSizes(photo)} />}
                <img
                  src={photo.heroSrc || photo.hd}
                  srcset={photo.srcset}
                  sizes={heroSizes(photo)}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover"
                  style={photo.focus ? `object-position: ${photo.focus}` : undefined}
                  fetchpriority="high"
                />
              </picture>
            ) : (
              <picture>
                {photo.heroPortrait && <source media="(max-aspect-ratio: 4/5)" type="image/avif" data-srcset={photo.heroPortrait.srcsetAvif} data-sizes={heroSizes({ width: 1290, height: 2000 })} />}
                {photo.heroPortrait && <source media="(max-aspect-ratio: 4/5)" type="image/webp" data-srcset={photo.heroPortrait.srcset} data-sizes={heroSizes({ width: 1290, height: 2000 })} />}
                {photo.srcsetAvif && <source type="image/avif" data-srcset={photo.srcsetAvif} data-sizes={heroSizes(photo)} />}
                <img
                  data-src={photo.heroSrc || photo.hd}
                  data-srcset={photo.srcset}
                  data-sizes={heroSizes(photo)}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover"
                  style={photo.focus ? `object-position: ${photo.focus}` : undefined}
                />
              </picture>
            )}
          </div>
        ))}
      </div>
      <div class="hero-top-scrim absolute inset-0 pointer-events-none" aria-hidden="true" />
      <div class="hero-text-scrim absolute inset-0 pointer-events-none" aria-hidden="true" />
    </>
  ) : (
    <div class="absolute inset-0 bg-canvas" />
  )}

  <div class="hero-content relative z-10 mx-auto w-full max-w-wide px-6 lg:px-8">
    <div class="max-w-4xl">
      <p data-hero-photographer class="hero-name eyebrow" data-config="about.photographer.name">{config.about.photographer.name}</p>
      <h1 data-hero-heading class="hero-heading text-display mt-5 font-display" data-config="home.hero.heading">{config.home.hero.heading}</h1>
    </div>
    <div class="hero-actions mt-8">
      <div data-hero-ctas class="flex flex-wrap items-center gap-x-7 gap-y-3">
        <a
          href={hasGalleries ? '/galleries' : '/photos/all/'}
          class="site-button hero-primary inline-flex items-center justify-center rounded-pill text-sm"
          data-astro-prefetch="viewport"
        >
          <span data-config="home.hero.cta1">{config.home.hero.cta1}</span>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a href="/contact" class="hero-secondary inline-flex items-center justify-center text-sm">
          <span data-config="home.hero.cta2">{config.home.hero.cta2}</span>
        </a>
      </div>

      {hasSlideshow && (
        <div class="hero-controls flex flex-wrap items-center justify-end" role="group" aria-label="Slideshow controls">
          {heroPriority.map((_, i) => (
            <button
              type="button"
              class="hero-slide-control"
              data-hero-dot={i}
              aria-label={`Show photo ${i + 1} of ${heroPriority.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
          <button type="button" class="hero-slide-control hero-pause" aria-pressed="false" aria-label="Pause slideshow">
            <svg data-hero-pause-icon class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
            <svg data-hero-play-icon class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
          </button>
        </div>
      )}
    </div>
    {heroPriority[0] && (
      <div class="mt-5 flex justify-end">
        <a
          data-hero-credit
          class="hero-credit eyebrow"
          href={`/photos/all/?cat=${encodeURIComponent(heroPriority[0].category)}`}
          hidden={!photoCredit(heroPriority[0])}
        >{photoCredit(heroPriority[0])}</a>
      </div>
    )}
  </div>
</section>

<script>
  let cleanupHero: (() => void) | undefined

  function initHero() {
    cleanupHero?.()
    cleanupHero = undefined

    const heroSection = document.querySelector<HTMLElement>('[data-hero-interval]')
    if (!heroSection) return

    const slides = Array.from(heroSection.querySelectorAll<HTMLElement>('[data-hero-slide]'))
    const dots = heroSection.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')
    const controls = heroSection.querySelector<HTMLElement>('.hero-controls')
    const pauseButton = heroSection.querySelector<HTMLButtonElement>('.hero-pause')
    const credit = heroSection.querySelector<HTMLAnchorElement>('[data-hero-credit]')
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const controller = new AbortController()
    const { signal } = controller
    let motionAllowed = !motionQuery.matches
    let disposed = false
    let heroVisible = false
    let hovered = controls?.matches(':hover') ?? false
    let focused = heroSection.contains(document.activeElement) && Boolean(document.activeElement?.matches(':focus-visible'))
    let userPaused = false
    let current = 0
    let requested = 0
    let requestVersion = 0
    let loading = false
    let fading = false
    let timer: ReturnType<typeof setTimeout> | undefined
    let finishFade: (() => void) | undefined
    let reveal: Animation | undefined
    let cancelWarmSlide: (() => void) | undefined

    const wait = (ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms))

    function decodeImage(img: HTMLImageElement | null, timeout: number) {
      if (!img) return Promise.resolve()
      return Promise.race([img.decode().catch(() => {}), wait(timeout)])
    }

    function warmSlide(index: number) {
      const slide = slides[index]
      const img = slide?.querySelector<HTMLImageElement>('img[data-src]')
      if (!img) return
      slide.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach(source => {
        source.sizes = source.dataset.sizes || ''
        source.srcset = source.dataset.srcset || ''
        source.removeAttribute('data-srcset')
        source.removeAttribute('data-sizes')
      })
      img.sizes = img.dataset.sizes || ''
      img.srcset = img.dataset.srcset || ''
      img.src = img.dataset.src || ''
      img.removeAttribute('data-src')
      img.removeAttribute('data-srcset')
      img.removeAttribute('data-sizes')
    }

    function stop() {
      clearTimeout(timer)
      timer = undefined
    }

    function isPaused() {
      return userPaused || hovered || focused || !heroVisible || document.hidden || !motionAllowed
    }

    function updatePlayback() {
      stop()
      const paused = isPaused()
      heroSection!.dataset.heroPaused = String(paused)
      if (disposed || slides.length < 2 || paused || loading || fading) return
      const interval = Number(heroSection!.dataset.heroInterval) || 6000
      timer = setTimeout(() => { void showSlide((current + 1) % slides.length, true) }, interval)
    }

    function setActive(index: number) {
      slides.forEach((slide, i) => {
        const active = i === index
        slide.classList.toggle('is-active', active)
        if (active) {
          slide.removeAttribute('aria-hidden')
          slide.setAttribute('role', 'img')
          slide.setAttribute('aria-label', slide.dataset.heroLabel || '')
        } else {
          slide.setAttribute('aria-hidden', 'true')
          slide.removeAttribute('role')
          slide.removeAttribute('aria-label')
        }
      })
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })
      if (credit) {
        credit.textContent = slides[index].dataset.heroCreditText || ''
        credit.href = slides[index].dataset.heroCreditHref || '/photos/all/'
        credit.hidden = !credit.textContent
      }
      current = index
    }

    async function showSlide(index: number, automatic = false) {
      if (disposed || slides.length < 2 || !slides[index]) return
      requested = index
      const version = ++requestVersion
      stop()

      // Finish the current fade at full coverage, then honor the latest dot click.
      if (fading) return
      loading = index !== current
      if (!loading) {
        updatePlayback()
        return
      }

      warmSlide(index)
      await decodeImage(slides[index].querySelector('img'), 1200)
      if (disposed || version !== requestVersion) return
      loading = false
      if (automatic && isPaused()) {
        requested = current
        updatePlayback()
        return
      }

      const outgoing = slides[current]
      const incoming = slides[index]
      if (!motionAllowed) {
        outgoing.style.transition = 'none'
        outgoing.style.opacity = '0'
        outgoing.style.zIndex = '0'
        incoming.style.transition = 'none'
        incoming.style.opacity = '1'
        incoming.style.zIndex = '1'
        setActive(index)
        updatePlayback()
        return
      }

      fading = true
      incoming.style.transition = 'none'
      incoming.style.opacity = '0'
      incoming.style.zIndex = '2'
      outgoing.style.zIndex = '1'
      // Commit the transparent incoming layer before enabling its transition.
      void incoming.offsetWidth
      incoming.style.removeProperty('transition')

      let fallback: ReturnType<typeof setTimeout>
      const finish = () => {
        clearTimeout(fallback)
        incoming.removeEventListener('transitionend', onTransitionEnd)
        incoming.style.transition = 'none'
        incoming.style.opacity = '1'
        incoming.style.zIndex = '1'
        outgoing.style.transition = 'none'
        outgoing.style.opacity = '0'
        outgoing.style.zIndex = '0'
        fading = false
        finishFade = undefined
        if (disposed) return
        if (requested !== current) void showSlide(requested)
        else updatePlayback()
      }
      const onTransitionEnd = (event: TransitionEvent) => {
        if (event.target === incoming && event.propertyName === 'opacity') finish()
      }
      finishFade = finish
      incoming.addEventListener('transitionend', onTransitionEnd)
      fallback = setTimeout(finish, 1600)
      setActive(index)
      incoming.style.opacity = '1'
      if (motionAllowed) warmSlide((index + 1) % slides.length)
    }

    const firstImg = slides[0]?.querySelector<HTMLImageElement>('img') || null
    if (firstImg && motionAllowed && !firstImg.complete) {
      // Only JS hides a still-loading image; SSR and cached images stay visible.
      firstImg.style.opacity = '0'
      void decodeImage(firstImg, 800).then(() => {
        if (disposed) return
        if (!motionAllowed) {
          firstImg.style.opacity = '1'
          return
        }
        reveal = firstImg.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 900,
          easing: 'cubic-bezier(.16,1,.3,1)',
          fill: 'both',
        })
        firstImg.style.removeProperty('opacity')
      })
    }

    if (slides.length > 1 && motionAllowed && firstImg) {
      const scheduleWarmSlide = () => {
        if (disposed || !motionAllowed) return
        const warmNext = () => {
          cancelWarmSlide = undefined
          if (!disposed && motionAllowed) warmSlide(1)
        }
        if (typeof window.requestIdleCallback === 'function') {
          const id = window.requestIdleCallback(warmNext)
          cancelWarmSlide = () => window.cancelIdleCallback(id)
        } else {
          const id = window.setTimeout(warmNext, 1500)
          cancelWarmSlide = () => window.clearTimeout(id)
        }
      }
      if (firstImg.complete && firstImg.naturalWidth > 0) scheduleWarmSlide()
      else firstImg.addEventListener('load', scheduleWarmSlide, { once: true, signal })
    }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        void showSlide(Number(dot.dataset.heroDot))
      }, { signal })
    })
    pauseButton?.addEventListener('click', () => {
      userPaused = !userPaused
      pauseButton.setAttribute('aria-pressed', String(userPaused))
      if (!userPaused) {
        hovered = false
        focused = false
      }
      updatePlayback()
    }, { signal })
    controls?.addEventListener('mouseenter', () => {
      hovered = true
      updatePlayback()
    }, { signal })
    controls?.addEventListener('mouseleave', () => {
      hovered = false
      updatePlayback()
    }, { signal })
    heroSection.addEventListener('focusin', event => {
      // Pointer focus (no :focus-visible) clears a pause left behind by earlier keyboard focus.
      focused = event.target instanceof Element && event.target.matches(':focus-visible')
      updatePlayback()
    }, { signal })
    heroSection.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && heroSection.contains(event.relatedTarget)) return
      focused = false
      updatePlayback()
    }, { signal })
    document.addEventListener('visibilitychange', updatePlayback, { signal })
    motionQuery.addEventListener('change', () => {
      motionAllowed = !motionQuery.matches
      if (!motionAllowed) {
        reveal?.cancel()
        firstImg?.style.removeProperty('opacity')
        finishFade?.()
      }
      updatePlayback()
    }, { signal })

    const observer = new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting
      updatePlayback()
    })
    observer.observe(heroSection)

    updatePlayback()
    cleanupHero = () => {
      disposed = true
      requestVersion++
      stop()
      cancelWarmSlide?.()
      finishFade?.()
      reveal?.cancel()
      firstImg?.style.removeProperty('opacity')
      observer.disconnect()
      controller.abort()
    }
  }

  initHero()
  document.addEventListener('astro:after-swap', initHero)
  document.addEventListener('astro:before-swap', () => cleanupHero?.())
</script>
