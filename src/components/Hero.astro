---
export interface Props {
  heroPriority: Array<{
    full: string
    thumb: string
    hd: string
    srcset: string
    title: string
    description: string
    blur: string
    width: number | null
    height: number | null
    category: string
    categoryName: string
    hero_priority: number
  }>
}

import config from '@lib/config'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}
const hasGalleries = galleries.length > 0

const { heroPriority } = Astro.props
const hasSlideshow = heroPriority.length > 1
const slideshowInterval = config.home.hero.slideshow_interval ?? 6000
const overlayOpacity = config.home.hero.overlay_opacity ?? 0.75

// The hero is a viewport-tall cover crop: when the viewport is narrower than the photo's
// aspect ratio, the painted width follows the height rather than 100vw.
function heroSizes(photo: { width: number | null; height: number | null }) {
  if (!photo.width || !photo.height) return '100vw'
  return `(max-aspect-ratio: ${photo.width}/${photo.height}) ${Math.ceil((photo.width / photo.height) * 100)}vh, 100vw`
}
---

<section class="photo-hero relative flex items-end justify-center overflow-hidden" data-hero-interval={slideshowInterval} style={`--hero-interval: ${slideshowInterval}ms`}>
  {heroPriority.length > 0 ? (
    <div class="absolute inset-0 z-0 hero-parallax pointer-events-none will-change-transform" id="hero-bg">
      {heroPriority.map((photo, i) => (
        <div
          class:list={["absolute inset-0 bg-cover bg-center hero-slide", i === 0 && "is-active"]}
          id={i === 0 ? 'hero-active-slide' : undefined}
          style={`background-image: url('${photo.blur}'); opacity: ${i === 0 ? 1 : 0};${hasSlideshow ? ' transition: opacity 1.5s ease, transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);' : ''}`}
          data-hero-slide={i}
          role="img"
          aria-label={photo.title}
        >
          {i === 0 ? (
            <img
              src={photo.hd}
              srcset={photo.srcset}
              sizes={heroSizes(photo)}
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
              fetchpriority="high"
            />
          ) : (
            <img
              data-src={photo.hd}
              data-srcset={photo.srcset}
              data-sizes={heroSizes(photo)}
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
        </div>
      ))}
      <div class="absolute inset-0" style={`background: linear-gradient(to top, rgba(0,0,0,${overlayOpacity}) 0%, rgba(0,0,0,${overlayOpacity}) 10%, rgba(0,0,0,${overlayOpacity * 0.55}) 30%, rgba(0,0,0,${overlayOpacity * 0.08}) 45%, rgba(0,0,0,0) 55%);`} />
    </div>
  ) : (
    <div class="absolute inset-0 bg-canvas" />
  )}

  <div class="hero-content relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-8">
    <div class="max-w-4xl">
      <p data-hero-photographer class="hero-name font-body font-medium uppercase opacity-0" data-config="about.photographer.name">{config.about.photographer.name}</p>
      <h1 data-hero-heading class="hero-heading mt-5 font-display text-[#f4f5f7]" data-config="home.hero.heading">
        {
          config.home.hero.heading.split(' ').map((word) => (
            <span class="inline-block overflow-hidden pb-1 -mb-1">
              <span class="inline-block opacity-0">{word}&nbsp;</span>
            </span>
          ))
        }
      </h1>
      <div data-hero-ctas class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-start">
        <a
          href={hasGalleries ? '/galleries' : '/photos/all/'}
          class="site-button hero-primary inline-flex items-center justify-center rounded-pill text-sm w-full sm:w-auto opacity-0"
        >
          <span data-config="home.hero.cta1">{config.home.hero.cta1}</span>
          <svg class="ml-2 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="/contact"
          class="site-button hero-secondary inline-flex items-center justify-center rounded-pill text-sm w-full sm:w-auto opacity-0"
        >
          <span data-config="home.hero.cta2">{config.home.hero.cta2}</span>
        </a>
      </div>
    </div>
  </div>

  {heroPriority.length > 0 && (
    <div class="absolute bottom-3 left-1/2 z-30 -translate-x-1/2 flex pointer-events-auto">
      {heroPriority.map((_, i) => (
        <button
          type="button"
          class="hero-slide-control"
          data-hero-dot={i}
          aria-label={`Slide ${i + 1}`}
          aria-pressed={i === 0}
        />
      ))}
    </div>
  )}
</section>

<script>
  import { animate, stagger } from 'framer-motion/dom'

  function initHero() {
    const slides = document.querySelectorAll('[data-hero-slide]')
    const dots = document.querySelectorAll('[data-hero-dot]')
    const heroBg = document.getElementById('hero-bg')
    const heroSection = document.querySelector('[data-hero-interval]') as HTMLElement | null
    let heroVisible = false
    let updateSlideshowVisibility = () => {}

    if (heroSection) {
      const observer = new IntersectionObserver(([entry]) => {
        heroVisible = entry.isIntersecting
        updateSlideshowVisibility()
      })
      observer.observe(heroSection)
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true })
    }

    const motionAllowed = !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (motionAllowed) {
    // --- Framer Motion Animations ---
    // 1. Background image cinematic reveal
    const firstSlide = document.querySelector('[data-hero-slide="0"]')
    if (firstSlide) {
      const img = firstSlide.querySelector('img')
      if (img) {
        animate(img, 
          { scale: [1.12, 1], opacity: [0.2, 1] }, 
          { duration: 2.8, ease: [0.16, 1, 0.3, 1] }
        )
      }
    }

    // 2. Photographer's name entrance
    const name = document.querySelector('[data-hero-photographer]')
    if (name) {
      animate(name, 
        { y: [15, 0], opacity: [0, 1] }, 
        { duration: 1.2, ease: [0.16, 1, 0.3, 1], delay: 0.1 }
      )
    }

    // 3. Heading entrance (dramatic animation)
    const words = document.querySelectorAll('[data-hero-heading] span > span')
    if (words.length > 0) {
      animate(words, 
        { y: [48, 0], rotate: [6, 0], scale: [0.96, 1], opacity: [0, 1] }, 
        { 
          duration: 1.5, 
          ease: [0.16, 1, 0.3, 1], 
          delay: stagger(0.08, { startDelay: 0.3 }) 
        }
      )
    }

    // 4. CTA buttons stagger reveal
    const ctas = document.querySelectorAll('[data-hero-ctas] > a')
    if (ctas.length > 0) {
      animate(ctas, 
        { y: [20, 0], opacity: [0, 1] }, 
        { 
          duration: 1.2, 
          ease: [0.16, 1, 0.3, 1],
          delay: stagger(0.1, { startDelay: 0.8 })
        }
      )
    }

    }

    // --- Slideshow Setup ---
    if (slides.length > 1) {
      let current = 0
      let interval: ReturnType<typeof setInterval> | null = null

      // Only the first slide's image is in the initial HTML; later slides are fetched
      // one step ahead so they never compete with the slide on screen for bandwidth.
      function warmSlide(index: number) {
        const img = slides[index]?.querySelector('img[data-src]') as HTMLImageElement | null
        if (!img) return
        img.sizes = img.dataset.sizes || ''
        img.srcset = img.dataset.srcset || ''
        img.src = img.dataset.src || ''
        img.removeAttribute('data-src')
      }

      if (motionAllowed) {
        const firstImg = slides[0].querySelector('img')
        firstImg?.decode().catch(() => {}).then(() => warmSlide(1))
      }

      function showSlide(index: number) {
        warmSlide(index)
        if (motionAllowed) warmSlide((index + 1) % slides.length)
        slides.forEach((s, i) => {
          ;(s as HTMLElement).style.opacity = i === index ? '1' : '0'
          s.classList.toggle('is-active', i === index)
        })
        dots.forEach((d, i) => {
          d.setAttribute('aria-pressed', String(i === index))
        })
        current = index
      }

      function next() {
        showSlide((current + 1) % slides.length)
      }

      function start() {
        stop()
        if (!heroVisible || document.hidden || !motionAllowed) return
        const heroInterval = parseInt(heroSection?.dataset.heroInterval || '', 10) || 6000
        interval = setInterval(next, heroInterval)
      }

      function stop() {
        if (interval) {
          clearInterval(interval)
          interval = null
        }
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt((dot as HTMLElement).dataset.heroDot || '', 10)
          if (!isNaN(idx) && idx !== current) showSlide(idx)
          start()
        })
      })

      if (heroBg) {
        heroBg.addEventListener('mouseenter', stop)
        heroBg.addEventListener('mouseleave', start)
      }

      // Hidden slide transitions can trigger large image decodes during gallery scrolling.
      updateSlideshowVisibility = start
      document.addEventListener('visibilitychange', updateSlideshowVisibility)
      start()

      // Clean up interval on page swap to avoid memory leaks
      document.addEventListener('astro:before-swap', () => {
        stop()
        document.removeEventListener('visibilitychange', updateSlideshowVisibility)
      }, { once: true })
    }

    // --- Parallax Setup ---
    if (heroBg) {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const isLowEnd = (() => {
        const cores = navigator.hardwareConcurrency || 4
        const mem = (navigator as any).deviceMemory || 4
        return cores <= 2 || mem <= 2
      })()

      if (!prefersReduced && !isLowEnd) {
        let lastY = 0
        let lowFpsCount = 0
        let lastFrameTime = performance.now()

        const onLenisScroll = (lenis: any) => {
          if (!heroVisible) return
          const now = performance.now()
          const dt = now - lastFrameTime
          lastFrameTime = now
          if (dt > 50) {
            lowFpsCount++
            if (lowFpsCount > 10) {
              if ((window as any).__lenis) {
                ;(window as any).__lenis.off('scroll', onLenisScroll)
              }
              heroBg.style.transform = ''
              return
            }
          } else {
            lowFpsCount = Math.max(0, lowFpsCount - 1)
          }

          const y = lenis.animatedScroll * 0.4
          if (Math.abs(y - lastY) < 0.1) return
          lastY = y
          heroBg.style.transform = `translate3d(0, ${y}px, 0)`
        }

        if ((window as any).__lenis) {
          ;(window as any).__lenis.on('scroll', onLenisScroll)
          
          // Clean up scroll listener on page swap
          document.addEventListener('astro:before-swap', () => {
            if ((window as any).__lenis) {
              ;(window as any).__lenis.off('scroll', onLenisScroll)
            }
          }, { once: true })
        }
      }
    }
  }

  // Run immediately for initial load (module scripts are deferred, so DOM is ready)
  initHero()

  // Run on subsequent client-side navigations
  document.addEventListener('astro:after-swap', initHero)
</script>
