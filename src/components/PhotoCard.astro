---
export interface Props {
  filename: string
  title: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  full: string
  width: number | null
  height: number | null
  blur: string
  index: number
  category?: string
}

const { title, thumb, gridSrcset, width, height, blur, index } = Astro.props
const imageStyle = [
  width && height ? `aspect-ratio: ${width} / ${height}` : undefined,
  blur ? `background: url('${blur}') center / cover no-repeat` : undefined,
].filter(Boolean).join('; ') || undefined
---

<img
  class="block w-full h-auto"
  src={thumb}
  srcset={gridSrcset || undefined}
  sizes="(min-width: 1280px) 384px, (min-width: 1024px) calc((100vw - 128px) / 3), (min-width: 640px) calc((100vw - 112px) / 3), calc(100vw - 48px)"
  width={width ?? undefined}
  height={height ?? undefined}
  style={imageStyle}
  alt={title}
  loading={index < 3 ? 'eager' : 'lazy'}
  fetchpriority={index === 0 ? 'high' : undefined}
  decoding="async"
/>
