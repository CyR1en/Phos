---
export interface Props {
  filename: string
  title: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  full: string
  width: number | null
  height: number | null
  blur: string
  index: number
  category?: string
}

const { title, thumb, gridSrcset, width, height, blur, index } = Astro.props
const ratio = width && height ? width / height : 1.5
const desktopSize = Math.min(Math.round(ratio * 400), 1696)
const tabletSize = Math.min(Math.round(ratio * 24), 100)
const mobileSize = Math.min(Math.round(ratio * 48), 100)
const imageStyle = blur ? `background: url('${blur}') center / cover no-repeat` : undefined
---

<img
  class="block h-full w-full object-cover"
  src={thumb}
  srcset={gridSrcset || undefined}
  sizes={`(min-width: 1760px) ${desktopSize}px, (min-width: 640px) ${tabletSize}vw, ${mobileSize}vw`}
  width={width ?? undefined}
  height={height ?? undefined}
  style={imageStyle}
  alt={title}
  loading={index < 3 ? 'eager' : 'lazy'}
  fetchpriority={index === 0 ? 'high' : undefined}
  decoding="async"
/>
