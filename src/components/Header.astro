---
import ThemeToggle from './ThemeToggle.astro'
import config from '@lib/config'
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { extname, join } from 'node:path'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}
const hasGalleries = galleries.length > 0
const brandName = config.site.title || config.about.photographer?.name || ''

const publicDir = join(process.cwd(), 'public')
const publicFiles = existsSync(publicDir) ? readdirSync(publicDir) : []
const logoFile = publicFiles.find(f => f === 'logo.svg')
const lightLogo = publicFiles.find(f => f.startsWith('logo_light.'))
const darkLogo = publicFiles.find(f => f.startsWith('logo_dark.'))

let logoSvg = null
let logoLight = null
let logoDark = null

if (logoFile) {
  logoSvg = readFileSync(publicDir + '/logo.svg', 'utf-8')
} else if (lightLogo) {
  logoLight = '/' + lightLogo
  const ext = extname(lightLogo)
  const darkName = darkLogo || `logo_dark${ext}`
  logoDark = darkLogo ? '/' + darkLogo : '/' + darkName
}

const pathname = Astro.url.pathname

function isActive(path: string) {
  const cleanPathname = pathname.replace(/^\/|\/$/g, '')
  const cleanPath = path.replace(/^\/|\/$/g, '')
  if (cleanPath === '') {
    return cleanPathname === ''
  }
  return cleanPathname === cleanPath || cleanPathname.startsWith(cleanPath + '/')
}
---

<div id="header-sentinel" class="pointer-events-none absolute left-0 top-0 h-px w-full" aria-hidden="true"></div>
<header class="sticky top-0 z-40 border-b border-border site-header">
  <nav class="mx-auto flex max-w-wide items-center justify-between px-6 lg:px-8 site-nav" aria-label="Primary">
    <a href="/" class="site-brand flex min-w-0 items-center gap-1.5" aria-label={brandName || 'Home'}>
      <div class="shrink-0">
        {logoSvg ? (
          <span class="size-6 text-ink" set:html={logoSvg} />
        ) : logoLight ? (
          <>
            <img src={logoLight} alt={brandName} class="h-6 w-auto dark:hidden" />
            <img src={logoDark} alt={brandName} class="hidden h-6 w-auto dark:block" />
          </>
        ) : null}
      </div>
      <span class="min-w-0 truncate font-display text-[1.375rem] tracking-[-0.01em] text-ink">{brandName}</span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {hasGalleries && (
        <a href="/galleries" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/galleries') ? 'page' : undefined}>Galleries</a>
      )}
      <a href="/photos/all/" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/photos') ? 'page' : undefined}>Photos</a>
      <a href="/about" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a href="/contact" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
    </div>

    <div class="flex shrink-0 items-center gap-3">
      <a href="/contact" class="hidden lg:inline-flex site-button items-center rounded-pill bg-primary text-primary-text hover:bg-primary-hover">Get in touch</a>
      <ThemeToggle />
      <button id="menu-btn" type="button" class="flex h-11 w-11 items-center justify-center rounded-sm text-ink hover:bg-surface transition-colors lg:hidden" data-hs-overlay="#mobile-nav" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div id="mobile-nav" class="hs-overlay hs-overlay-open:translate-x-0 hidden fixed inset-y-0 end-0 z-[80] w-full max-w-sm bg-canvas border-s border-border transition-transform translate-x-full" role="dialog" tabindex="-1" aria-label="Navigation">
  <div class="flex items-center justify-between border-b border-border px-6 py-4">
    <a href="/" class="flex min-w-0 items-center gap-1.5" aria-label={brandName || 'Home'}>
      <div class="shrink-0">
        {logoSvg ? (
          <span class="size-6 text-ink" set:html={logoSvg} />
        ) : logoLight ? (
          <>
            <img src={logoLight} alt={brandName} class="h-6 w-auto dark:hidden" />
            <img src={logoDark} alt={brandName} class="hidden h-6 w-auto dark:block" />
          </>
        ) : null}
      </div>
      <span class="min-w-0 truncate font-display text-[1.375rem] tracking-[-0.01em] text-ink">{brandName}</span>
    </a>
    <button type="button" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm text-ink hover:bg-surface transition-colors" data-hs-overlay="#mobile-nav" aria-label="Close menu">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-2 px-6 pt-8">
    {hasGalleries && (
      <a href="/galleries" class:list={['rounded-sm px-4 py-3 text-sm font-medium transition-colors', isActive('/galleries') ? 'bg-surface text-ink font-semibold' : 'text-ink hover:bg-surface']} aria-current={isActive('/galleries') ? 'page' : undefined}>Galleries</a>
    )}
    <a href="/photos/all/" class:list={['rounded-sm px-4 py-3 text-sm font-medium transition-colors', isActive('/photos') ? 'bg-surface text-ink font-semibold' : 'text-ink hover:bg-surface']} aria-current={isActive('/photos') ? 'page' : undefined}>Photos</a>
    <a href="/about" class:list={['rounded-sm px-4 py-3 text-sm font-medium transition-colors', isActive('/about') ? 'bg-surface text-ink font-semibold' : 'text-ink hover:bg-surface']} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
    <a href="/contact" class:list={['rounded-sm px-4 py-3 text-sm font-medium transition-colors', isActive('/contact') ? 'bg-surface text-ink font-semibold' : 'text-ink hover:bg-surface']} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
  </nav>
</div>

<script>
  function setupMobileNav() {
    const mobileNav = document.getElementById('mobile-nav')
    const menuBtn = document.getElementById('menu-btn')
    if (!mobileNav) return

    function onOpen() {
      menuBtn?.setAttribute('aria-expanded', 'true')
      document.body.classList.add('mobile-nav-open')
      window.__lenis?.stop()
    }

    function onClose() {
      menuBtn?.setAttribute('aria-expanded', 'false')
      document.body.classList.remove('mobile-nav-open')
      window.__lenis?.start()
    }

    mobileNav.addEventListener('open.hs.overlay', onOpen)
    mobileNav.addEventListener('close.hs.overlay', onClose)
  }

  // Keep the light header while it overlays the hero; other pages use the sentinel.
  function setupHeaderScroll() {
    const header = document.querySelector('.site-header')
    const sentinel = document.getElementById('header-sentinel')
    const hero = document.querySelector('.photo-hero')
    const target = hero || sentinel
    if (!header || !target) return
    const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-header-height')) || 0

    const observer = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting)
    }, { threshold: 0, rootMargin: hero ? `-${headerHeight}px 0px 0px 0px` : '-1px 0px 0px 0px' })
    observer.observe(target)

    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true })
  }

  setupMobileNav()
  setupHeaderScroll()
  document.addEventListener('astro:after-swap', setupMobileNav)
  document.addEventListener('astro:after-swap', setupHeaderScroll)

  document.addEventListener('astro:before-swap', () => {
    const HSOverlay = (window as any).HSOverlay
    if (HSOverlay) {
      const instance = HSOverlay.getInstance('#mobile-nav')
      if (instance?.isOpened()) instance.close()
    }
    document.body.classList.remove('mobile-nav-open')
    window.__lenis?.start()
  })
</script>
