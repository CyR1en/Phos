---
import ThemeToggle from './ThemeToggle.astro'
import config from '@lib/config'
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { extname, join } from 'node:path'

const publicDir = join(process.cwd(), 'public')
const publicFiles = existsSync(publicDir) ? readdirSync(publicDir) : []
const logoFile = publicFiles.find(f => f === 'logo.svg')
const lightLogo = publicFiles.find(f => f.startsWith('logo_light.'))
const darkLogo = publicFiles.find(f => f.startsWith('logo_dark.'))

let logoSvg = null
let logoLight = null
let logoDark = null

if (logoFile) {
  logoSvg = readFileSync(publicDir + '/logo.svg', 'utf-8')
} else if (lightLogo) {
  logoLight = '/' + lightLogo
  const ext = extname(lightLogo)
  const darkName = darkLogo || `logo_dark${ext}`
  logoDark = darkLogo ? '/' + darkLogo : '/' + darkName
}

const pathname = Astro.url.pathname

function isActive(path: string) {
  const cleanPathname = pathname.replace(/^\/|\/$/g, '')
  const cleanPath = path.replace(/^\/|\/$/g, '')
  if (cleanPath === '') {
    return cleanPathname === ''
  }
  return cleanPathname === cleanPath || cleanPathname.startsWith(cleanPath + '/')
}
---

<header class="sticky top-0 z-40 border-b border-border site-header">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 lg:px-8 site-nav">
    <a href="/" class="site-brand flex items-center gap-1.5 shrink-0" aria-label={config.site.title || "Home"}>
      <div>
        {logoSvg ? (
          <span class="size-6 text-ink" set:html={logoSvg} />
        ) : logoLight ? (
          <>
            <img src={logoLight} alt={config.site.title} class="h-6 w-auto dark:hidden" />
            <img src={logoDark} alt={config.site.title} class="hidden h-6 w-auto dark:block" />
          </>
        ) : null}
      </div>
      <div class="font-display text-xl tracking-wide text-ink">{config.site.title}</div>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      <a href="/" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/') ? "page" : undefined}>Home</a>
      <a href="/galleries" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/galleries') ? "page" : undefined}>Galleries</a>
      <a href="/photos/all" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/photos') ? "page" : undefined}>Photos</a>
      <a href="/about" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/about') ? "page" : undefined}>About</a>
      <a href="/contact" class="site-nav-link text-sm font-medium transition-colors" aria-current={isActive('/contact') ? "page" : undefined}>Contact</a>
    </div>

    <div class="flex items-center gap-3">
      <a href="/contact" class="hidden lg:inline-flex site-button items-center rounded-pill bg-primary px-6 py-2 text-sm font-medium text-primary-text hover:bg-primary-hover transition-colors">Get in touch</a>
      <ThemeToggle />
      <button id="menu-btn" type="button" class="flex h-11 w-11 items-center justify-center rounded-sm text-ink hover:bg-surface transition-colors lg:hidden" data-hs-overlay="#mobile-nav" aria-label="Open menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div id="mobile-nav" class="hs-overlay hs-overlay-open:translate-x-0 hidden fixed inset-y-0 end-0 z-[80] w-full max-w-sm bg-canvas border-s border-border transition-transform translate-x-full" role="dialog" tabindex="-1" aria-label="Navigation">
  <div class="flex items-center justify-between border-b border-border px-6 py-4">
    <div class="flex items-center gap-1.5">
      <div>
        {logoSvg ? (
          <span class="size-6 text-ink" set:html={logoSvg} />
        ) : logoLight ? (
          <>
            <img src={logoLight} alt={config.site.title} class="h-6 w-auto dark:hidden" />
            <img src={logoDark} alt={config.site.title} class="hidden h-6 w-auto dark:block" />
          </>
        ) : null}
      </div>
      <div class="font-display text-xl tracking-wide text-ink">{config.site.title}</div>
    </div>
    <button type="button" class="flex h-11 w-11 items-center justify-center rounded-sm text-ink hover:bg-surface transition-colors" data-hs-overlay="#mobile-nav" aria-label="Close menu">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-2 px-6 pt-8">
    <a href="/" class:list={["rounded-sm px-4 py-3 text-sm font-medium transition-colors", isActive('/') ? "bg-primary/10 text-primary font-semibold" : "text-ink hover:bg-surface"]}>Home</a>
    <a href="/galleries" class:list={["rounded-sm px-4 py-3 text-sm font-medium transition-colors", isActive('/galleries') ? "bg-primary/10 text-primary font-semibold" : "text-ink hover:bg-surface"]}>Galleries</a>
    <a href="/photos/all" class:list={["rounded-sm px-4 py-3 text-sm font-medium transition-colors", isActive('/photos') ? "bg-primary/10 text-primary font-semibold" : "text-ink hover:bg-surface"]}>Photos</a>
    <a href="/about" class:list={["rounded-sm px-4 py-3 text-sm font-medium transition-colors", isActive('/about') ? "bg-primary/10 text-primary font-semibold" : "text-ink hover:bg-surface"]}>About</a>
    <a href="/contact" class:list={["rounded-sm px-4 py-3 text-sm font-medium transition-colors", isActive('/contact') ? "bg-primary/10 text-primary font-semibold" : "text-ink hover:bg-surface"]}>Contact</a>
  </nav>
</div>

<script>
  function setupMobileNav() {
    const mobileNav = document.getElementById('mobile-nav')
    if (!mobileNav) return

    function onOpen() {
      document.body.classList.add('mobile-nav-open')
      window.__lenis?.stop()
    }

    function onClose() {
      document.body.classList.remove('mobile-nav-open')
      window.__lenis?.start()
    }

    mobileNav.addEventListener('open.hs.overlay', onOpen)
    mobileNav.addEventListener('close.hs.overlay', onClose)
  }

  setupMobileNav()
  document.addEventListener('astro:after-swap', setupMobileNav)

  document.addEventListener('astro:before-swap', () => {
    const HSOverlay = (window as any).HSOverlay
    if (HSOverlay) {
      const instance = HSOverlay.getInstance('#mobile-nav')
      if (instance?.isOpened()) instance.close()
    }
    document.body.classList.remove('mobile-nav-open')
    window.__lenis?.start()
  })
</script>
