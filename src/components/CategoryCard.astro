---
export interface Props {
  name: string
  slug: string
  description: string
  cover: string | null
  coverWidth: number | null
  coverHeight: number | null
  photoCount: number
  blur: string
  link?: string
  displayTitle?: string
  displayDescription?: string
  actionLabel?: string
}

const { name, slug, description, cover, coverWidth, coverHeight, photoCount, blur, link, displayTitle, displayDescription, actionLabel = 'View photos' } = Astro.props
const cardTitle = displayTitle || name
const cardDescription = displayDescription !== undefined ? displayDescription : description
const cardLink = link || `/photos/all/?cat=${slug}`
---

<article data-animate class="showcase-item animate-reveal">
  <a
    href={cardLink}
    class="photo-card group"
    aria-label={`${cardTitle}, ${photoCount} photo${photoCount !== 1 ? 's' : ''}`}
  >
    <div class="photo-card-frame">
      <div
        class="photo-card-image"
        style={blur ? `background-image: url('${blur}')` : undefined}
      >
        {cover ? (
          <img
            src={cover}
            alt=""
            loading="lazy"
            fetchpriority="low"
            decoding="async"
            width={coverWidth ?? undefined}
            height={coverHeight ?? undefined}
          />
        ) : (
          <span class="photo-card-placeholder" aria-hidden="true">{cardTitle}</span>
        )}
      </div>
    </div>

    <div class="photo-card-copy">
      <span class="photo-card-count">{photoCount} photo{photoCount !== 1 ? 's' : ''}</span>
      <h3 class="photo-card-title">{cardTitle}</h3>
      {cardDescription && <p class="photo-card-description">{cardDescription}</p>}
      <span class="photo-card-action">
        {actionLabel}
        <span class="photo-card-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 18 18 6M6 6h12v12" />
          </svg>
        </span>
      </span>
    </div>
  </a>
</article>
