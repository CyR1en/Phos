---
export interface Props {
  name: string
  slug: string
  description: string
  cover: string | null
  coverSrcset?: string
  coverWidth: number | null
  coverHeight: number | null
  coverFocus?: string | null
  photoCount: number
  blur: string
  link?: string
  displayTitle?: string
  displayDescription?: string
  actionLabel?: string
}

const { name, slug, description, cover, coverSrcset, coverWidth, coverHeight, coverFocus, photoCount, blur, link, displayTitle, displayDescription, actionLabel = 'View photos' } = Astro.props
const cardTitle = displayTitle || name
const cardDescription = displayDescription !== undefined ? displayDescription : description
const cardLink = link || `/photos/all/?cat=${slug}`
---

<article data-animate class="showcase-item animate-reveal">
  <a
    href={cardLink}
    class="photo-card group"
    aria-label={`${cardTitle}, ${photoCount} photo${photoCount !== 1 ? 's' : ''}`}
  >
    <div class="photo-card-frame">
      <div
        class="photo-card-image"
        style={`aspect-ratio: ${coverWidth && coverHeight ? (coverWidth >= coverHeight ? '3 / 2' : '4 / 5') : '3 / 2'};${blur ? ` background-image: url('${blur}')` : ''}`}
      >
        {cover ? (
          <img
            src={cover}
            srcset={coverSrcset || undefined}
            sizes={coverSrcset ? '(min-width: 1600px) 867px, (min-width: 1536px) calc((1472px - 5vw) * 33 / 53), (min-width: 1024px) calc((95vw - 64px) * 33 / 53), (min-width: 768px) calc((95vw - 48px) * 33 / 53), calc(100vw - 32px)' : undefined}
            alt=""
            loading="lazy"
            fetchpriority="low"
            decoding="async"
            width={coverWidth ?? undefined}
            height={coverHeight ?? undefined}
            style={coverFocus ? `object-position: ${coverFocus}` : undefined}
          />
        ) : (
          <span class="photo-card-placeholder" aria-hidden="true">{cardTitle}</span>
        )}
      </div>
    </div>

    <div class="photo-card-copy">
      <span class="photo-card-count eyebrow">{photoCount} photo{photoCount !== 1 ? 's' : ''}</span>
      <h3 class="photo-card-title text-h3 font-display text-ink">{cardTitle}</h3>
      {cardDescription && <p class="photo-card-description">{cardDescription}</p>}
      <span class="photo-card-action">
        {actionLabel}
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 18 18 6M6 6h12v12" />
        </svg>
      </span>
    </div>
  </a>
</article>
