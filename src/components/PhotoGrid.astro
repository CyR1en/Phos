---
import PhotoCard from '@components/PhotoCard.astro'

interface Photo {
  filename: string
  title: string
  full: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  width: number | null
  height: number | null
  blur: string
  focus?: string | null
  category?: string
}

interface Props {
  photos: Photo[]
  wrapperClass?: string
}

const { photos, wrapperClass } = Astro.props
---

<div class="justified-grid">
  {photos.map((photo, i) => (
    <a
      href={photo.full}
      class:list={['photo-card-wrap block overflow-hidden rounded-photo', wrapperClass]}
      style={`--r: ${photo.width && photo.height ? (photo.width / photo.height).toFixed(4) : '1.5'}`}
      data-category={photo.category || undefined}
      data-index={i}
      data-astro-reload
      data-astro-prefetch="false"
      aria-haspopup="dialog"
      aria-label={`View ${photo.title}`}
    >
      <PhotoCard
        filename={photo.filename}
        title={photo.title}
        thumb={photo.thumb}
        thumbMobile={photo.thumbMobile}
        gridSrcset={photo.gridSrcset}
        full={photo.full}
        width={photo.width}
        height={photo.height}
        blur={photo.blur}
        index={i}
        category={photo.category}
      />
    </a>
  ))}
</div>

<style>
  .photo-card-wrap[data-reveal-pending] {
    opacity: 0;
    clip-path: inset(6% 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card-wrap {
      opacity: 1 !important;
      clip-path: none !important;
    }
  }
</style>

<script>
  let revealObserver: IntersectionObserver | undefined

  function initPhotoGrid() {
    revealObserver?.disconnect()
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    if (!('IntersectionObserver' in window)) return

    revealObserver = new IntersectionObserver((entries, observer) => {
      const visible = entries
        .filter((entry) => {
          const card = entry.target as HTMLElement
          if (card.dataset.animated) observer.unobserve(card)
          return entry.isIntersecting && !card.dataset.animated
        })
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top
          || a.boundingClientRect.left - b.boundingClientRect.left)

      visible.forEach((entry, index) => {
        const card = entry.target as HTMLElement
        card.dataset.animated = 'true'
        card.animate(
          [
            { opacity: 0, clipPath: 'inset(6% 0 0 0)' },
            { opacity: 1, clipPath: 'inset(0)' },
          ],
          {
            duration: 900,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            delay: Math.min(index * 60, 300),
            fill: 'backwards',
          }
        )
        delete card.dataset.revealPending
        observer.unobserve(card)
      })
    })

    document.querySelectorAll<HTMLElement>('.photo-card-wrap').forEach((card) => {
      if (card.dataset.animated) return
      card.dataset.revealPending = 'true'
      revealObserver?.observe(card)
    })
  }

  // Run immediately for initial load
  initPhotoGrid()

  // Run on subsequent navigations
  const w = window as any
  if (!w.__photoGridBound) {
    w.__photoGridBound = true
    document.addEventListener('astro:after-swap', initPhotoGrid)
    document.addEventListener('astro:before-swap', () => revealObserver?.disconnect())
  }
</script>
