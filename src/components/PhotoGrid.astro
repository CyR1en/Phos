---
import PhotoCard from '@components/PhotoCard.astro'

interface Photo {
  filename: string
  title: string
  full: string
  thumb: string
  thumbMobile: string
  gridSrcset?: string
  width: number | null
  height: number | null
  blur: string
  category?: string
}

interface Props {
  photos: Photo[]
  wrapperClass?: string
}

const { photos, wrapperClass } = Astro.props
---

<div class="columns-1 sm:columns-3 gap-8">
  {photos.map((photo, i) => (
    <a
      href={photo.full}
      class:list={['photo-card-wrap mb-8 block break-inside-avoid overflow-hidden rounded-lg shadow-sm', wrapperClass]}
      data-category={photo.category || undefined}
      data-index={i}
      data-astro-reload
      data-astro-prefetch="false"
      aria-haspopup="dialog"
      aria-label={`View ${photo.title}`}
    >
      <PhotoCard
        filename={photo.filename}
        title={photo.title}
        thumb={photo.thumb}
        thumbMobile={photo.thumbMobile}
        gridSrcset={photo.gridSrcset}
        full={photo.full}
        width={photo.width}
        height={photo.height}
        blur={photo.blur}
        index={i}
        category={photo.category}
      />
    </a>
  ))}
</div>

<style>
  .photo-card-wrap {
    opacity: 0;
    transform: translateY(32px);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card-wrap {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { inView, animate } from 'framer-motion/dom'

  function initPhotoGrid() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const cards = document.querySelectorAll('.photo-card-wrap')
    cards.forEach((card) => {
      if ((card as HTMLElement).dataset.animated) return
      ;(card as HTMLElement).dataset.animated = 'true'

      const index = parseInt((card as HTMLElement).dataset.index || '0', 10)
      const delay = (index % 3) * 0.12 // Stagger columns slightly

      inView(card, (element) => {
        animate(
          element,
          { opacity: 1, y: 0 },
          {
            duration: 0.9,
            ease: [0.16, 1, 0.3, 1],
            delay: delay,
          }
        )
      }, { margin: '0px 0px -50px 0px' })
    })
  }

  // Run immediately for initial load
  initPhotoGrid()

  // Run on subsequent navigations
  document.addEventListener('astro:after-swap', initPhotoGrid)
</script>
