<!-- Scroll reveals only: section visibility and staggered page headers. -->
<script>
  let scrollObserver: IntersectionObserver | undefined
  let headerObserver: IntersectionObserver | undefined

  function disconnectObservers() {
    scrollObserver?.disconnect()
    headerObserver?.disconnect()
  }

  function initScrollAnimations() {
    disconnectObservers()
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return
        entry.target.setAttribute('data-visible', '')
        observer.unobserve(entry.target)
      })
    }, { threshold: 0.1 })
    scrollObserver = observer

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el))

    const headers = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return
        const header = entry.target
        headers.unobserve(header)
        if (header.dataset.animated) return
        header.dataset.animated = 'true'
        header.classList.remove('opacity-0')
        if (motionQuery.matches) return
        Array.from(header.children).forEach((child, i) => {
          child.animate([
            { opacity: 0, transform: 'translateY(20px)' },
            { opacity: 1, transform: 'none' },
          ], {
            duration: 900,
            easing: 'cubic-bezier(.16,1,.3,1)',
            delay: i * 120,
            fill: 'backwards',
          })
        })
      })
    }, { rootMargin: '0px 0px -60px 0px' })
    headerObserver = headers

    document.querySelectorAll<HTMLElement>('[data-animate-header]').forEach(header => {
      if (header.dataset.animated) return
      if (motionQuery.matches) {
        header.dataset.animated = 'true'
        header.classList.remove('opacity-0')
        return
      }
      headers.observe(header)
    })
  }

  initScrollAnimations()
  document.addEventListener('astro:after-swap', initScrollAnimations)
  document.addEventListener('astro:before-swap', disconnectObservers)
</script>
