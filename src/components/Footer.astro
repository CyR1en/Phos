---
import config from '@lib/config'

let galleries: any[] = []
try {
  const gals = await import('@lib/galleries').then(m => m.default || m)
  galleries = gals.galleries || []
} catch {
  galleries = []
}
const hasGalleries = galleries.length > 0

const year = new Date().getFullYear()
const name = config.about.photographer?.name || config.site.title || ''
const email = config.about.photographer?.email
const social = (config.site.social || []).filter(s => s.platform && s.url)

const ICONS: Record<string, string> = {
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
  youtube: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>`,
  github: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
}
---

<footer class="bg-canvas text-ink">
  <div class="mx-auto max-w-wide px-6 lg:px-8">
    <div class="py-10 flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-display text-[1.5rem] text-ink" data-config="about.photographer.name">{name}</p>
        {email && <a href={`mailto:${email}`} class="mt-2 inline-block text-sm text-body-muted hover:text-ink transition-colors">{email}</a>}
      </div>

      <div class="flex flex-col gap-6 sm:items-end">
        <nav class="flex flex-wrap items-center gap-x-7 gap-y-2" aria-label="Footer">
          {hasGalleries && (
            <a href="/galleries" class="text-sm text-body-muted hover:text-ink transition-colors">Galleries</a>
          )}
          <a href="/photos/all/" class="text-sm text-body-muted hover:text-ink transition-colors">Photos</a>
          <a href="/about" class="text-sm text-body-muted hover:text-ink transition-colors">About</a>
          <a href="/contact" class="text-sm text-body-muted hover:text-ink transition-colors">Contact</a>
        </nav>

        {social.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {social.map(({ platform, url }) => {
              const icon = ICONS[platform.toLowerCase()]
              return (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={platform}
                  class="inline-grid size-11 place-items-center text-body-muted hover:text-ink transition-colors"
                >
                  {icon ? (
                    <span set:html={icon} />
                  ) : (
                    <span class="text-xs">{platform}</span>
                  )}
                </a>
              )
            })}
          </div>
        )}
      </div>
    </div>
    <div class="border-t border-border py-6">
      <p class="eyebrow">&copy; {year} {name}</p>
    </div>
  </div>
</footer>
