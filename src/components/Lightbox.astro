---
import type { LightboxPhoto } from '../scripts/lightbox/types'

interface Photo extends Record<string, any> {
  filename?: string
  category?: string
  title?: string
  titleIsAuto?: boolean
  description?: string
  thumb?: string
  srcset?: string
  full?: string
  width?: number | null
  height?: number | null
}

export interface Props {
  photos: Photo[]
}

const { photos } = Astro.props
const list: LightboxPhoto[] = photos.map((photo) => ({
  filename: photo.filename ?? '',
  category: photo.category,
  title: photo.title ?? '',
  titleIsAuto: photo.titleIsAuto,
  description: photo.description,
  thumb: photo.thumb ?? '',
  srcset: photo.srcset ?? '',
  full: photo.srcset ? undefined : photo.full,
  width: photo.width ?? null,
  height: photo.height ?? null,
}))
const json = JSON.stringify(list).replace(/</g, '\\u003c')
---

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer" tabindex="-1">
  <button id="lightbox-close" class="lightbox-button" type="button" aria-label="Close photo viewer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>

  <button id="lightbox-prev" class="lightbox-button" type="button" aria-label="Previous photo" disabled>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
  </button>

  <button id="lightbox-next" class="lightbox-button" type="button" aria-label="Next photo" disabled>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
  </button>

  <button id="lightbox-zoom" class="lightbox-button" type="button" aria-pressed="false" aria-label="Zoom">
    <span data-zoom-in-icon aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M10.5 7.5v6m-3-3h6"/></svg>
    </span>
    <span data-zoom-out-icon aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M7.5 10.5h6"/></svg>
    </span>
  </button>

  <div id="lightbox-stage">
    <img id="lightbox-img-a" class="lightbox-layer" alt="" draggable="false" />
    <img id="lightbox-img-b" class="lightbox-layer" alt="" draggable="false" aria-hidden="true" />
    <div id="lightbox-error" hidden><span>Failed to load image</span></div>
  </div>

  <div class="lightbox-caption">
    <div class="lightbox-caption-text">
      <div id="lightbox-title" hidden></div>
      <div id="lightbox-description" hidden></div>
    </div>
    <div id="lightbox-counter"></div>
  </div>
  <div id="lightbox-live" class="lightbox-live" aria-live="polite" aria-atomic="true"></div>
  <script type="application/json" id="lightbox-data" set:html={json} />
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox/index'

  initLightbox()
  document.addEventListener('astro:after-swap', initLightbox)
</script>
